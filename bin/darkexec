#!/usr/bin/env python3
"""Dispatch one visible target task through a visible DarkExec control task."""

from __future__ import annotations

import argparse, base64, fcntl, hashlib, json
import os, select, shutil, signal, socket, struct, subprocess, sys
import tempfile, time, tomllib
from datetime import datetime, timedelta, timezone
from pathlib import Path

STATE_ROOT = Path(os.environ.get("DARKEXEC_STATE_ROOT", "/var/lib/darkexec/jobs"))
SESSION_ROOT = Path(os.environ.get("DARKEXEC_SESSION_ROOT", "/var/lib/darkexec/sessions"))
WORKSPACE = Path(os.environ.get("DARKEXEC_WORKSPACE", "/srv/darkexec"))
CONFIG = Path(os.environ.get("DARKEXEC_CONFIG", "/root/.codex/config.toml"))
DOCTRINE = Path(os.environ.get("DARKEXEC_DOCTRINE", str(WORKSPACE / "harness-ops.md")))
TURN_TIMEOUT = int(os.environ.get("DARKEXEC_TURN_TIMEOUT", "0"))
UPDATE_REPOSITORY = os.environ.get("DARKEXEC_UPDATE_REPOSITORY", "https://github.com/DarkExec/darkexec")
UPDATE_REF = os.environ.get("DARKEXEC_UPDATE_REF", "main")
APP_SERVER_SOCKET = Path(os.environ.get("DARKEXEC_APP_SERVER_SOCKET",
                                        "/root/.codex/app-server-control/app-server-control.sock"))
HARNESS_PROMPT = (
    "Let's do a harness pass where we take a look at this session and turn trial and error into fast, "
    f"reliable, and durable execution. Make sure we are following {DOCTRINE} doctrine."
)
READ_ONLY_HARNESS_PROMPT = (
    "FIRE DRILL harness proof only. Review this task's completed trajectory without using tools, inspecting "
    "files, changing state, continuing product work, or contacting anyone. Briefly report whether the request "
    "stayed read-only and whether any harness change is warranted; make no change."
)
def now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


class DispatchInterrupted(Exception):
    def __init__(self, signum: int):
        super().__init__(f"interrupted by signal {signum}")
        self.signum = signum


def atomic_write(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    rendered = json.dumps(payload, indent=2) + "\n"
    with tempfile.NamedTemporaryFile("w", dir=path.parent, prefix=f".{path.name}.", delete=False) as handle:
        handle.write(rendered)
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    os.replace(temporary, path)
    os.chmod(path, 0o600)


def receipt_path(job_id: str) -> Path:
    return STATE_ROOT / f"{hashlib.sha256(job_id.encode()).hexdigest()}.json"

def session_path(thread_id: str) -> Path:
    return SESSION_ROOT / f"{hashlib.sha256(thread_id.encode()).hexdigest()}.json"

def load_receipt(path: Path) -> dict:
    return json.loads(path.read_text())

def saved_project(path: Path) -> bool:
    try:
        config = tomllib.loads(CONFIG.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return False
    return str(path) in (config.get("projects") or {})


def saved_projects() -> list[str]:
    try:
        config = tomllib.loads(CONFIG.read_text())
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise SystemExit(f"cannot read saved Codex projects: {exc}") from exc
    projects = config.get("projects") or {}
    if not isinstance(projects, dict):
        raise SystemExit("cannot read saved Codex projects: projects must be a table")
    return sorted(path for path in projects if isinstance(path, str) and Path(path).is_absolute())


def usage(raw: dict | None) -> dict:
    raw = raw or {}
    return {
        "input": int(raw.get("inputTokens") or raw.get("input_tokens") or 0),
        "cacheRead": int(raw.get("cachedInputTokens") or raw.get("cached_input_tokens") or 0),
        "output": int(raw.get("outputTokens") or raw.get("output_tokens") or 0),
        "reasoningOutput": int(raw.get("reasoningOutputTokens") or raw.get("reasoning_output_tokens") or 0),
        "total": int(raw.get("totalTokens") or raw.get("total_tokens") or 0),
    }


def usage_delta(after: dict, before: dict) -> dict:
    return {key: max(0, int(after.get(key) or 0) - int(before.get(key) or 0)) for key in after}

class AppServer:
    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(str(APP_SERVER_SOCKET))
        self.buffer = b""
        key = base64.b64encode(os.urandom(16)).decode()
        request = (
            "GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\n"
            f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        ).encode()
        self.sock.sendall(request)
        deadline = time.monotonic() + 5
        while b"\r\n\r\n" not in self.buffer:
            self.buffer += self._read_socket(deadline)
        headers, self.buffer = self.buffer.split(b"\r\n\r\n", 1)
        expected = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest())
        if b" 101 " not in headers or b"sec-websocket-accept: " + expected.lower() not in headers.lower():
            raise RuntimeError(f"App Server WebSocket upgrade failed: {headers[:500]!r}")
        self.request_id = 0
        self.thread_usage: dict[str, dict] = {}
        self.active_turn: tuple[str, str] | None = None
        self.signal_handlers = {
            signum: signal.signal(signum, self._handle_signal)
            for signum in (signal.SIGTERM, signal.SIGINT)
        }
        self._request("initialize", {
            "clientInfo": {"name": "darkexec", "version": "1"},
            "capabilities": {
                "experimentalApi": True,
                "optOutNotificationMethods": [
                    "item/agentMessage/delta", "item/reasoning/textDelta",
                    "item/reasoning/summaryTextDelta", "item/commandExecution/outputDelta",
                ],
            },
        })
        self._send({"jsonrpc": "2.0", "method": "initialized", "params": {}})

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()

    def _handle_signal(self, signum, _frame) -> None:
        self.interrupt_active()
        raise DispatchInterrupted(signum)

    def _send(self, payload: dict) -> None:
        self._send_frame(json.dumps(payload).encode())

    def _read_socket(self, deadline: float | None) -> bytes:
        remaining = None if deadline is None else deadline - time.monotonic()
        if remaining is not None and remaining <= 0:
            raise TimeoutError("App Server response timeout")
        if not select.select([self.sock], [], [], remaining)[0]:
            raise TimeoutError("App Server response timeout")
        chunk = self.sock.recv(65536)
        if not chunk:
            raise RuntimeError("App Server WebSocket closed unexpectedly")
        return chunk

    def _take(self, count: int, deadline: float | None) -> bytes:
        while len(self.buffer) < count:
            self.buffer += self._read_socket(deadline)
        value, self.buffer = self.buffer[:count], self.buffer[count:]
        return value

    def _send_frame(self, payload: bytes, opcode: int = 1) -> None:
        mask = os.urandom(4)
        length = len(payload)
        header = bytes([0x80 | opcode])
        if length < 126:
            header += bytes([0x80 | length])
        elif length < 65536:
            header += bytes([0x80 | 126]) + struct.pack("!H", length)
        else:
            header += bytes([0x80 | 127]) + struct.pack("!Q", length)
        masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
        self.sock.sendall(header + mask + masked)

    def _next(self, deadline: float | None) -> dict:
        fragments = bytearray()
        while True:
            first, second = self._take(2, deadline)
            opcode, masked = first & 0x0F, bool(second & 0x80)
            length = second & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._take(2, deadline))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._take(8, deadline))[0]
            mask = self._take(4, deadline) if masked else b""
            payload = self._take(length, deadline)
            if masked:
                payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
            if opcode == 8:
                raise RuntimeError("App Server WebSocket closed")
            if opcode == 9:
                self._send_frame(payload, opcode=10)
                continue
            if opcode not in {0, 1}:
                continue
            fragments.extend(payload)
            if first & 0x80:
                return json.loads(fragments.decode())

    def _request(self, method: str, params: dict, timeout: int = 30) -> dict:
        self.request_id += 1
        request_id = self.request_id
        self._send({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
        deadline = time.monotonic() + timeout
        while True:
            message = self._next(deadline)
            if message.get("id") != request_id:
                continue
            if message.get("error"):
                raise RuntimeError(str(message["error"]))
            return message.get("result") or {}

    def start_thread(self, cwd: Path) -> dict:
        result = self._request("thread/start", {
            "cwd": str(cwd), "approvalPolicy": "never", "sandbox": "danger-full-access",
            "ephemeral": False, "threadSource": "darkexec",
        })
        thread = result.get("thread") if isinstance(result.get("thread"), dict) else {}
        if not thread.get("id"):
            raise RuntimeError("App Server did not return a thread identity")
        return thread

    def require_listed_thread(self, thread_id: str, cwd: Path) -> dict:
        listed = self._request("thread/list", {"cwd": str(cwd), "sourceKinds": ["vscode"], "limit": 100,
                                                "sortKey": "created_at", "sortDirection": "desc",
                                                "useStateDbOnly": True})
        match = next((item for item in listed.get("data", []) if item.get("id") == thread_id
                      and item.get("cwd") == str(cwd) and item.get("source") == "vscode"), None)
        if not match:
            raise RuntimeError(f"Task {thread_id} was not listed by the running Codex App.")
        return match

    def read_thread(self, thread_id: str) -> dict:
        result = self._request("thread/read", {"threadId": thread_id, "includeTurns": True})
        thread = result.get("thread") if isinstance(result.get("thread"), dict) else {}
        if thread.get("id") != thread_id:
            raise RuntimeError(f"App Server did not return target task {thread_id}")
        return thread

    def run_turn(self, thread_id: str, prompt: str) -> dict:
        self.request_id += 1
        request_id = self.request_id
        self._send({
            "jsonrpc": "2.0", "id": request_id, "method": "turn/start",
            "params": {"threadId": thread_id, "input": [{"type": "text", "text": prompt}]},
        })
        deadline = time.monotonic() + TURN_TIMEOUT if TURN_TIMEOUT > 0 else None
        turn_id = None
        messages: list[str] = []
        final_usage = None
        model_calls = 0
        try:
            while True:
                message = self._next(deadline)
                if message.get("id") == request_id:
                    if message.get("error"):
                        raise RuntimeError(str(message["error"]))
                    turn_id = ((message.get("result") or {}).get("turn") or {}).get("id")
                    if turn_id:
                        self.active_turn = (thread_id, turn_id)
                    continue
                method = message.get("method")
                params = message.get("params") if isinstance(message.get("params"), dict) else {}
                if params.get("threadId") != thread_id:
                    continue
                if method == "item/completed":
                    item = params.get("item") if isinstance(params.get("item"), dict) else {}
                    if item.get("type") == "agentMessage" and item.get("text"):
                        messages.append(str(item["text"]))
                elif method == "thread/tokenUsage/updated" and (not turn_id or params.get("turnId") == turn_id):
                    token_usage = params.get("tokenUsage") if isinstance(params.get("tokenUsage"), dict) else {}
                    final_usage = usage(token_usage.get("total") if isinstance(token_usage.get("total"), dict) else {})
                    model_calls += 1
                elif method == "turn/completed":
                    turn = params.get("turn") if isinstance(params.get("turn"), dict) else {}
                    if not turn_id or turn.get("id") != turn_id:
                        continue
                    previous = self.thread_usage.get(thread_id, {key: 0 for key in usage({})})
                    current = final_usage or previous
                    self.thread_usage[thread_id] = current
                    result_text = messages[-1] if messages else ""
                    ok = turn.get("status") == "completed" and bool(result_text)
                    self.active_turn = None
                    return {
                        "ok": ok, "timedOut": False, "exitCode": 0 if ok else 1,
                        "threadId": thread_id, "turnId": turn_id,
                        "resultText": result_text[:12000],
                        "usage": usage_delta(current, previous),
                        "modelCallCount": model_calls or None,
                        "error": "" if ok else str(turn.get("error") or "App task failed without a final response"),
                    }
        except TimeoutError:
            self.interrupt_active()
            return {
                "ok": False, "timedOut": True, "exitCode": None, "threadId": thread_id,
                "error": f"Codex App turn exceeded {TURN_TIMEOUT} seconds.",
            }

    def interrupt_active(self) -> None:
        if not self.active_turn:
            return
        thread_id, turn_id = self.active_turn
        try:
            self._request("turn/interrupt", {"threadId": thread_id, "turnId": turn_id}, timeout=5)
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError):
            pass
        self.active_turn = None

    def stop(self) -> None:
        try:
            self._send_frame(b"", opcode=8)
        except OSError:
            pass

    def close(self) -> None:
        self.stop()
        self.sock.close()
        for signum, handler in self.signal_handlers.items():
            signal.signal(signum, handler)


def add_usage(receipt: dict) -> None:
    entries = [
        (receipt.get("executive") or {}).get("initialUsage"),
        (receipt.get("executive") or {}).get("closeoutUsage"),
        (receipt.get("target") or {}).get("initialUsage"),
        ((receipt.get("target") or {}).get("harness") or {}).get("usage"),
    ]
    totals = {key: 0 for key in ("input", "cacheRead", "output", "reasoningOutput", "total")}
    for entry in entries:
        if isinstance(entry, dict):
            for key in totals:
                totals[key] += int(entry.get(key) or 0)
    receipt["cumulativeUsage"] = totals


def save(path: Path, receipt: dict, status: str) -> None:
    receipt["status"] = status
    receipt["updatedAt"] = now()
    add_usage(receipt)
    atomic_write(path, receipt)


def closeout_executive(receipt: dict, path: Path, app: AppServer) -> None:
    thread_id = (receipt.get("executive") or {}).get("threadId")
    if not thread_id:
        return
    target_id = (receipt.get("target") or {}).get("threadId") or "unavailable"
    prompt = (
        f"DarkExec job {receipt['jobId']} reached {receipt['status']}. Target task: {target_id}. "
        f"Same-task harness: {((receipt.get('target') or {}).get('harness') or {}).get('status', 'not_started')}. "
        "Do not inspect or change anything. Reply with those identities and statuses only."
    )
    result = app.run_turn(thread_id, prompt)
    receipt["executive"]["closeoutUsage"] = result.get("usage")
    receipt["executive"]["closeoutModelCallCount"] = result.get("modelCallCount")
    receipt["executive"]["closeoutResult"] = result.get("resultText")
    receipt["executive"]["closeoutStatus"] = "completed" if result.get("ok") else "failed"
    save(path, receipt, receipt["status"])


def dispatch(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir():
        raise SystemExit(f"target is not a directory: {target}")
    if not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("dispatch requires a non-empty prompt on stdin")
    path = receipt_path(args.job_id)
    request_sha = hashlib.sha256(prompt.encode()).hexdigest()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = path.with_suffix(".lock").open("a+")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if path.exists():
            current = load_receipt(path)
            print(json.dumps(current) if args.json else render_status(current))
        else:
            print(json.dumps({"jobId": args.job_id, "status": "starting"}) if args.json else f"{args.job_id}: starting")
        return 1
    if path.exists():
        prior = load_receipt(path)
        if prior.get("requestSha256") != request_sha or prior.get("targetPath") != str(target):
            raise SystemExit("job id already belongs to a different request or target")
        print(json.dumps(prior) if args.json else render_status(prior))
        return 0 if prior.get("status") == "completed" else 1

    receipt = {
        "schemaVersion": 1, "jobId": args.job_id, "requestSha256": request_sha,
        "targetPath": str(target), "transport": "codex-app-server-control-socket",
        "createdAt": now(), "executive": {}, "target": {},
    }
    save(path, receipt, "registering")
    interrupted_exit = None
    control_prompt = (
        f"DARKEXEC CONTROL TASK. Register job {args.job_id} for exact saved project {target}. "
        f"The target request SHA-256 is {request_sha}. Do not inspect files, use tools, or perform "
        f"the target work. Reply only: DARKEXEC_DISPATCH_READY {args.job_id}"
    )
    try:
        with AppServer() as app:
            executive_thread = app.start_thread(WORKSPACE)
            executive = app.run_turn(executive_thread["id"], control_prompt)
            executive_thread = app.require_listed_thread(executive_thread["id"], WORKSPACE)
            receipt["executive"] = {
                "threadId": executive_thread["id"], "source": executive_thread.get("source"),
                "appVisible": True, "listedCwd": executive_thread.get("cwd"),
                "initialUsage": executive.get("usage"),
                "initialModelCallCount": executive.get("modelCallCount"),
                "initialResult": executive.get("resultText"),
            }
            if not executive.get("ok"):
                receipt["error"] = executive.get("error") or "DarkExec control task did not complete."
                save(path, receipt, "failed")
                print(json.dumps(receipt) if args.json else render_status(receipt))
                return 1

            save(path, receipt, "target_running")
            target_thread = app.start_thread(target)
            target_result = app.run_turn(target_thread["id"], prompt)
            target_thread = app.require_listed_thread(target_thread["id"], target)
            receipt["target"] = {
                "threadId": target_thread["id"], "source": target_thread.get("source"),
                "appVisible": True, "listedCwd": target_thread.get("cwd"),
                "initialUsage": target_result.get("usage"),
                "modelCallCount": target_result.get("modelCallCount"),
                "resultText": target_result.get("resultText"), "harness": {"status": "not_started"},
            }
            if not target_result.get("ok"):
                receipt["error"] = target_result.get("error") or "Target task failed before a durable result."
                save(path, receipt, "failed")
                closeout_executive(receipt, path, app)
                print(json.dumps(receipt) if args.json else render_status(receipt))
                return 1

            save(path, receipt, "harness_running")
            harness_prompt = READ_ONLY_HARNESS_PROMPT if args.read_only_harness else HARNESS_PROMPT
            harness = app.run_turn(target_thread["id"], harness_prompt)
            receipt["target"]["harness"] = {
                "status": "completed" if harness.get("ok") else "failed",
                "usage": harness.get("usage"), "modelCallCount": harness.get("modelCallCount"),
                "resultText": harness.get("resultText"), "error": harness.get("error") or None,
            }
            if not harness.get("ok"):
                receipt["error"] = harness.get("error") or "Same-task harness turn failed."
                save(path, receipt, "failed")
            else:
                save(path, receipt, "completed")
            closeout_executive(receipt, path, app)
    except DispatchInterrupted as exc:
        receipt["error"] = str(exc)
        save(path, receipt, "interrupted")
        interrupted_exit = 128 + exc.signum
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        receipt["error"] = f"Native Codex App transport failed: {exc}"
        save(path, receipt, "failed")
    print(json.dumps(receipt) if args.json else render_status(receipt))
    if interrupted_exit is not None:
        return interrupted_exit
    return 0 if receipt.get("status") == "completed" else 1


def run_target(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir():
        raise SystemExit(f"target is not a directory: {target}")
    if not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("run requires a non-empty prompt on stdin")
    result = {
        "schemaVersion": 1, "targetPath": str(target),
        "transport": "codex-app-server-control-socket", "createdAt": now(),
    }
    interrupted_exit = None
    try:
        with AppServer() as app:
            thread = app.start_thread(target)
            target_result = app.run_turn(thread["id"], prompt)
            thread = app.require_listed_thread(thread["id"], target)
            result["target"] = {
                "threadId": thread["id"], "source": thread.get("source"),
                "appVisible": True, "listedCwd": thread.get("cwd"),
                "resultText": target_result.get("resultText"),
                "usage": target_result.get("usage"),
                "modelCallCount": target_result.get("modelCallCount"),
            }
            if not target_result.get("ok"):
                result["status"] = "failed"
                result["error"] = target_result.get("error") or "Target task failed."
            else:
                harness_prompt = READ_ONLY_HARNESS_PROMPT if args.read_only_harness else HARNESS_PROMPT
                harness = app.run_turn(thread["id"], harness_prompt)
                result["harness"] = {
                    "status": "completed" if harness.get("ok") else "failed",
                    "resultText": harness.get("resultText"),
                    "usage": harness.get("usage"),
                    "modelCallCount": harness.get("modelCallCount"),
                    "error": harness.get("error") or None,
                }
                result["status"] = "completed" if harness.get("ok") else "failed"
                if not harness.get("ok"):
                    result["error"] = harness.get("error") or "Same-task harness turn failed."
    except DispatchInterrupted as exc:
        result["status"] = "interrupted"
        result["error"] = str(exc)
        interrupted_exit = 128 + exc.signum
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        result["status"] = "failed"
        result["error"] = f"Native Codex App transport failed: {exc}"
    result["updatedAt"] = now()
    print(json.dumps(result) if args.json else (
        f"{result['status']} target={(result.get('target') or {}).get('threadId') or '-'} "
        f"harness={(result.get('harness') or {}).get('status', 'not_started')}"
    ))
    if interrupted_exit is not None:
        return interrupted_exit
    return 0 if result.get("status") == "completed" else 1


def user_text(turn: dict) -> str:
    chunks = []
    for item in turn.get("items", []):
        if item.get("type") != "userMessage":
            continue
        for content in item.get("content", []):
            if content.get("type") == "text" and content.get("text"):
                chunks.append(str(content["text"]))
    return "\n".join(chunks)


def stop_timer(unit: str | None) -> None:
    controller = os.environ.get("DARKEXEC_SYSTEMCTL") or shutil.which("systemctl")
    if not unit or not controller:
        return
    subprocess.run(
        [controller, "stop", f"{unit}.timer", f"{unit}.service"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    )


def schedule_timer(state: dict, executable: Path) -> tuple[bool, str]:
    runner = os.environ.get("DARKEXEC_SYSTEMD_RUN") or shutil.which("systemd-run")
    if not runner:
        return False, "systemd-run is unavailable"
    digest = hashlib.sha256(state["threadId"].encode()).hexdigest()[:12]
    state["timerAttempt"] = int(state.get("timerAttempt") or 0) + 1
    unit = f"darkexec-closeout-{digest}-g{state['generation']}-a{state['timerAttempt']}"
    seconds = int(state["debounceSeconds"])
    command = [
        runner, f"--unit={unit}", f"--on-active={seconds}s", "--collect", "--quiet",
        f"--setenv=DARKEXEC_SESSION_ROOT={SESSION_ROOT}",
        f"--setenv=DARKEXEC_CONFIG={CONFIG}",
        f"--setenv=DARKEXEC_APP_SERVER_SOCKET={APP_SERVER_SOCKET}",
        f"--setenv=DARKEXEC_WORKSPACE={WORKSPACE}",
        str(executable), "_debounce-fire", "--thread", state["threadId"],
        "--generation", str(state["generation"]),
    ]
    completed = subprocess.run(command, capture_output=True, text=True, check=False)
    if completed.returncode:
        return False, completed.stderr.strip() or completed.stdout.strip() or "systemd-run failed"
    state["timerUnit"] = unit
    return True, ""


def inspect_closeout(thread: dict, product_turn_id: str) -> tuple[str, str]:
    turns = thread.get("turns") if isinstance(thread.get("turns"), list) else []
    index = next((i for i, turn in enumerate(turns) if turn.get("id") == product_turn_id), None)
    if index is None:
        return "failed", f"recorded product turn {product_turn_id} was not found"
    product = turns[index]
    if product.get("status") != "completed":
        return "deferred", f"recorded product turn is {product.get('status') or 'unknown'}"
    for turn in turns[index + 1:]:
        prompt = user_text(turn)
        lowered = prompt.lower()
        if (
            prompt in {HARNESS_PROMPT, READ_ONLY_HARNESS_PROMPT}
            or ("harness pass" in lowered and "harness-ops" in lowered)
            or "harness proof only" in lowered
        ):
            return "manual_harness_seen", f"harness turn {turn.get('id') or '-'} is {turn.get('status') or 'unknown'}"
        if turn.get("status") not in {"completed", "failed", "interrupted", "cancelled"}:
            return "deferred", f"newer turn {turn.get('id') or '-'} is active"
        if prompt:
            return "superseded", f"newer product turn {turn.get('id') or '-'} exists"
    return "ready", ""


def fire_debounce(thread_id: str, generation: int, executable: Path) -> dict:
    path = session_path(thread_id)
    if not path.exists():
        return {"status": "stale", "threadId": thread_id, "reason": "session state is absent"}
    lock = path.with_suffix(".lock").open("a+")
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    state = load_receipt(path)
    if int(state.get("generation") or 0) != generation or state.get("status") != "pending":
        return {"status": "stale", "threadId": thread_id, "generation": generation}
    target = Path(state["targetPath"])
    if not target.is_dir() or not saved_project(target):
        state.update({
            "status": "failed", "error": f"target is no longer an exact saved Codex project: {target}",
            "updatedAt": now(), "timerUnit": None,
        })
        atomic_write(path, state)
        return {"status": "failed", "threadId": thread_id, "error": state["error"]}
    try:
        with AppServer() as app:
            app.require_listed_thread(thread_id, target)
            thread = app.read_thread(thread_id)
            status, reason = inspect_closeout(thread, state["productTurnId"])
            if status == "deferred":
                state["updatedAt"] = now()
                state["dueAt"] = (
                    datetime.now(timezone.utc) + timedelta(seconds=int(state["debounceSeconds"]))
                ).replace(microsecond=0).isoformat().replace("+00:00", "Z")
                scheduled, error = schedule_timer(state, executable)
                state["timerUnit"] = state.get("timerUnit") if scheduled else None
                state["error"] = None if scheduled else error
                state["status"] = "pending" if scheduled else "failed"
                atomic_write(path, state)
                return {"status": state["status"], "threadId": thread_id, "reason": reason, "error": error or None}
            if status != "ready":
                state.update({"status": status, "reason": reason, "updatedAt": now(), "timerUnit": None})
                atomic_write(path, state)
                return {"status": status, "threadId": thread_id, "reason": reason}
            result = app.run_turn(thread_id, state["harnessPrompt"])
            state.update({
                "status": "completed" if result.get("ok") else "failed",
                "harnessTurnId": result.get("turnId"), "harnessResult": result.get("resultText"),
                "error": result.get("error") or None, "updatedAt": now(), "timerUnit": None,
            })
            atomic_write(path, state)
            return {
                "status": state["status"], "threadId": thread_id,
                "harnessTurnId": state.get("harnessTurnId"), "error": state.get("error"),
            }
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        state.update({"status": "failed", "error": f"debounced closeout failed: {exc}", "updatedAt": now()})
        atomic_write(path, state)
        return {"status": "failed", "threadId": thread_id, "error": state["error"]}


def arm_debounce(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir() or not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    path = session_path(args.thread)
    prior = load_receipt(path) if path.exists() else {}
    if os.environ.get("DARKEXEC_DEBOUNCE_SKIP_PREFLIGHT") != "1":
        try:
            with AppServer() as app:
                app.require_listed_thread(args.thread, target)
                thread = app.read_thread(args.thread)
                preflight_status, reason = inspect_closeout(thread, args.turn)
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
            raise SystemExit(f"cannot preflight debounced closeout: {exc}") from exc
        if preflight_status != "ready":
            if preflight_status in {"manual_harness_seen", "superseded"}:
                stop_timer(prior.get("timerUnit"))
            result = {"status": preflight_status, "threadId": args.thread, "reason": reason}
            print(json.dumps(result) if args.json else f"{args.thread}: {preflight_status} ({reason})")
            return 0 if preflight_status in {"manual_harness_seen", "superseded"} else 1
    stop_timer(prior.get("timerUnit"))
    generation = int(prior.get("generation") or 0) + 1
    state = {
        "schemaVersion": 1, "threadId": args.thread, "targetPath": str(target),
        "productTurnId": args.turn, "generation": generation,
        "debounceSeconds": args.seconds, "harnessMode": args.harness_mode,
        "harnessPrompt": READ_ONLY_HARNESS_PROMPT if args.harness_mode == "read-only" else HARNESS_PROMPT,
        "status": "pending", "createdAt": prior.get("createdAt") or now(),
        "updatedAt": now(),
        "dueAt": (datetime.now(timezone.utc) + timedelta(seconds=args.seconds)).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    }
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    atomic_write(path, state)
    scheduled, error = schedule_timer(state, Path(sys.argv[0]).resolve())
    if scheduled:
        atomic_write(path, state)
        result = {
            "status": "pending", "threadId": args.thread, "productTurnId": args.turn,
            "generation": generation, "dueAt": state["dueAt"], "timerUnit": state["timerUnit"],
        }
        print(json.dumps(result) if args.json else f"{args.thread}: harness pending until {state['dueAt']}")
        return 0
    state["scheduleError"] = error
    atomic_write(path, state)
    result = fire_debounce(args.thread, generation, Path(sys.argv[0]).resolve())
    result["scheduleError"] = error
    print(json.dumps(result) if args.json else f"{args.thread}: harness {result['status']} ({error})")
    return 0 if result.get("status") in {"completed", "manual_harness_seen", "superseded"} else 1


def cancel_debounce(args) -> int:
    path = session_path(args.thread)
    if not path.exists():
        result = {"status": "absent", "threadId": args.thread}
    else:
        state = load_receipt(path)
        stop_timer(state.get("timerUnit"))
        state.update({"status": "cancelled", "timerUnit": None, "updatedAt": now()})
        atomic_write(path, state)
        result = {"status": "cancelled", "threadId": args.thread, "generation": state.get("generation")}
    print(json.dumps(result) if args.json else f"{args.thread}: {result['status']}")
    return 0


def debounce_status(args) -> int:
    path = session_path(args.thread)
    if not path.exists():
        result = {"status": "absent", "threadId": args.thread}
    else:
        state = load_receipt(path)
        result = {
            key: state.get(key) for key in (
                "schemaVersion", "threadId", "targetPath", "productTurnId", "generation",
                "status", "dueAt", "timerUnit", "harnessTurnId", "error", "updatedAt",
            )
        }
    print(json.dumps(result) if args.json else (
        f"{args.thread}: {result['status']} due={result.get('dueAt') or '-'} "
        f"harness={result.get('harnessTurnId') or '-'}"
    ))
    return 0


def update_install(args) -> int:
    with tempfile.TemporaryDirectory(prefix="darkexec-update-") as temporary:
        checkout = Path(temporary) / "darkexec"
        clone = ["git", "clone", "--quiet", "--depth", "1"]
        if UPDATE_REF:
            clone.extend(["--branch", UPDATE_REF])
        clone.extend([UPDATE_REPOSITORY, str(checkout)])
        fetched = subprocess.run(clone, capture_output=True, text=True, check=False)
        if fetched.returncode:
            raise SystemExit(f"cannot fetch DarkExec update: {fetched.stderr.strip() or fetched.stdout.strip()}")
        installed = subprocess.run(
            [str(checkout / "scripts/install.sh")],
            capture_output=True, text=True, check=False,
        )
        if installed.returncode:
            raise SystemExit(f"cannot install DarkExec update: {installed.stderr.strip() or installed.stdout.strip()}")
        lines = [line for line in installed.stdout.splitlines() if line.strip()]
        try:
            receipt = json.loads(lines[-1])
        except (IndexError, json.JSONDecodeError) as exc:
            raise SystemExit("DarkExec update installer returned no valid receipt") from exc
    result = {"status": "updated", "repository": UPDATE_REPOSITORY, "ref": UPDATE_REF or None, **receipt}
    print(json.dumps(result) if args.json else (
        f"updated commit={result.get('commit')} workspace={result.get('workspace')} "
        f"next={result.get('nextAction')}"
    ))
    return 0


def find_receipt(job_id: str | None, thread_id: str | None) -> dict:
    if job_id:
        path = receipt_path(job_id)
        if not path.exists():
            raise SystemExit(f"unknown DarkExec job: {job_id}")
        return load_receipt(path)
    for path in sorted(STATE_ROOT.glob("*.json"), key=lambda item: item.stat().st_mtime, reverse=True):
        receipt = load_receipt(path)
        ids = {
            (receipt.get("executive") or {}).get("threadId"),
            (receipt.get("target") or {}).get("threadId"),
        }
        if thread_id in ids:
            return receipt
    raise SystemExit(f"unknown DarkExec thread: {thread_id}")


def render_status(receipt: dict) -> str:
    return (
        f"{receipt.get('jobId')}: {receipt.get('status')} "
        f"executive={(receipt.get('executive') or {}).get('threadId') or '-'} "
        f"target={(receipt.get('target') or {}).get('threadId') or '-'} "
        f"harness={((receipt.get('target') or {}).get('harness') or {}).get('status', 'not_started')}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(prog="darkexec")
    sub = parser.add_subparsers(dest="command", required=True)
    launch = sub.add_parser("dispatch")
    launch.add_argument("--target", required=True)
    launch.add_argument("--job-id", required=True)
    launch.add_argument("--prompt-stdin", action="store_true", required=True)
    launch.add_argument("--read-only-harness", action="store_true")
    launch.add_argument("--json", action="store_true")
    run = sub.add_parser("run")
    run.add_argument("--target", required=True)
    run.add_argument("--prompt-stdin", action="store_true", required=True)
    harness = run.add_mutually_exclusive_group(required=True)
    harness.add_argument("--read-only-harness", action="store_true")
    harness.add_argument("--standard-harness", action="store_true")
    run.add_argument("--json", action="store_true")
    debounce = sub.add_parser("debounce")
    debounce.add_argument("--target", required=True)
    debounce.add_argument("--thread", required=True)
    debounce.add_argument("--turn", required=True)
    debounce.add_argument("--seconds", type=int, default=1800)
    debounce.add_argument("--harness-mode", choices=("read-only", "standard"), required=True)
    debounce.add_argument("--json", action="store_true")
    cancel = sub.add_parser("debounce-cancel")
    cancel.add_argument("--thread", required=True)
    cancel.add_argument("--json", action="store_true")
    debounce_read = sub.add_parser("debounce-status")
    debounce_read.add_argument("--thread", required=True)
    debounce_read.add_argument("--json", action="store_true")
    fire = sub.add_parser("_debounce-fire")
    fire.add_argument("--thread", required=True)
    fire.add_argument("--generation", type=int, required=True)
    projects = sub.add_parser("projects")
    projects.add_argument("--json", action="store_true")
    update = sub.add_parser("update")
    update.add_argument("--json", action="store_true")
    status = sub.add_parser("status")
    identity = status.add_mutually_exclusive_group(required=True)
    identity.add_argument("--job-id")
    identity.add_argument("--thread")
    status.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.command == "dispatch":
        return dispatch(args)
    if args.command == "run":
        return run_target(args)
    if args.command == "debounce":
        if args.seconds < 1:
            raise SystemExit("debounce seconds must be positive")
        return arm_debounce(args)
    if args.command == "debounce-cancel":
        return cancel_debounce(args)
    if args.command == "debounce-status":
        return debounce_status(args)
    if args.command == "_debounce-fire":
        result = fire_debounce(args.thread, args.generation, Path(sys.argv[0]).resolve())
        print(json.dumps(result))
        return 0 if result.get("status") in {"completed", "manual_harness_seen", "superseded", "stale", "pending"} else 1
    if args.command == "projects":
        paths = saved_projects()
        print(json.dumps({"schemaVersion": 1, "projects": paths}) if args.json else "\n".join(paths))
        return 0
    if args.command == "update":
        return update_install(args)
    receipt = find_receipt(args.job_id, args.thread)
    print(json.dumps(receipt) if args.json else render_status(receipt))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
