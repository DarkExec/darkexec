#!/usr/bin/env python3
"""Dispatch one visible target task through a visible DarkExec control task."""

from __future__ import annotations

import argparse, base64, fcntl, hashlib, json, re
import os, select, shutil, signal, socket, struct, subprocess, sys
import tempfile, time, tomllib
from datetime import datetime, timedelta, timezone
from pathlib import Path

STATE_ROOT = Path(os.environ.get("DARKEXEC_STATE_ROOT", "/var/lib/darkexec/jobs"))
SESSION_ROOT = Path(os.environ.get("DARKEXEC_SESSION_ROOT", "/var/lib/darkexec/sessions"))
HARNESS_EPISODE_ROOT = Path(os.environ.get(
    "DARKEXEC_HARNESS_EPISODE_ROOT", "/var/lib/darkexec/harness-episodes"
))
EXECUTION_ROOT = Path(os.environ.get("DARKEXEC_EXECUTION_ROOT", "/var/lib/darkexec/executives"))
CONTROL_ROOT = Path(os.environ.get("DARKEXEC_CONTROL_ROOT", "/var/lib/darkexec/controls"))
WORKSPACE = Path(os.environ.get("DARKEXEC_WORKSPACE", "/srv/darkexec"))
CONFIG = Path(os.environ.get("DARKEXEC_CONFIG", "/root/.codex/config.toml"))
DOCTRINE = Path(os.environ.get("DARKEXEC_DOCTRINE", str(WORKSPACE / "harness-ops.md")))
HARNESS_PROMPT_PATH = Path(os.environ.get(
    "DARKEXEC_HARNESS_PROMPT_PATH", "/var/lib/darkexec/config/harness-prompt.txt"
))
EFFICIENCY_PROMPT_PATH = Path(os.environ.get(
    "DARKEXEC_EFFICIENCY_PROMPT_PATH", "/var/lib/darkexec/config/efficiency-prompt.txt"
))
HARNESS_PROJECT_PROMPT_ROOT = Path(os.environ.get(
    "DARKEXEC_HARNESS_PROJECT_PROMPT_ROOT", "/var/lib/darkexec/config/harness-prompts"
))
EFFICIENCY_PROJECT_PROMPT_ROOT = Path(os.environ.get(
    "DARKEXEC_EFFICIENCY_PROJECT_PROMPT_ROOT", "/var/lib/darkexec/config/efficiency-prompts"
))
TURN_TIMEOUT = int(os.environ.get("DARKEXEC_TURN_TIMEOUT", "0"))
UPDATE_REPOSITORY = os.environ.get("DARKEXEC_UPDATE_REPOSITORY", "https://github.com/DarkExec/darkexec")
UPDATE_REF = os.environ.get("DARKEXEC_UPDATE_REF", "main")
REMOTE_PROTOCOL_VERSION = 1
APP_SERVER_SOCKET = Path(os.environ.get("DARKEXEC_APP_SERVER_SOCKET",
                                        "/root/.codex/app-server-control/app-server-control.sock"))
DEFAULT_HARNESS_PROMPT = (
    "Let's do a harness pass where we take a look at this session and turn trial and error into fast, "
    f"reliable, and durable execution. Make sure we are following {DOCTRINE} doctrine. After reading "
    "that doctrine, if docs/passes/harness/AGENTS.md exists in the target repository, read it and follow "
    "its routing."
)
DEFAULT_EFFICIENCY_PROMPT = (
    "Now briefly review the harness pass you just performed—not the original product work. Identify its "
    "single largest avoidable source of model calls, token consumption, retries, or repeated context recovery.\n\n"
    f"Follow {DOCTRINE} doctrine. After reading that doctrine, if docs/passes/efficiency/AGENTS.md exists in "
    "the target repository, read it and follow its routing.\n\n"
    "If one small change to the existing harness execution path would materially reduce that cost for future "
    "harness passes, implement and validate it."
)
MAX_HARNESS_PROMPT = 20000
MAX_HARNESS_NOTE = 2000
CLOSEOUT_ACTIVITY_SPAN_LIMIT = 64
READ_ONLY_HARNESS_PROMPT = (
    "FIRE DRILL harness proof only. Review this task's completed trajectory without using tools, inspecting "
    "files, changing state, continuing product work, or contacting anyone. Briefly report whether the request "
    "stayed read-only and whether any harness change is warranted; make no change."
)
def now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def validate_harness_prompt(value: str) -> str:
    value = value.strip()
    if not value:
        raise ValueError("harness prompt must not be empty")
    if len(value) > MAX_HARNESS_PROMPT:
        raise ValueError(f"harness prompt exceeds {MAX_HARNESS_PROMPT} characters")
    return value


def prepend_harness_note(prompt: str, note: str) -> str:
    note = note.strip()
    if not note:
        return prompt
    if len(note) > MAX_HARNESS_NOTE:
        raise ValueError(f"harness note exceeds {MAX_HARNESS_NOTE} characters")
    separator = " " if note.endswith((".", "!", "?", ":", ";")) else ". "
    return validate_harness_prompt(f"{note}{separator}{prompt}")


def configured_prompt(path: Path, default: str, label: str) -> str:
    if not path.exists():
        return default
    try:
        return validate_harness_prompt(path.read_text())
    except OSError as exc:
        raise RuntimeError(f"cannot read {label} prompt setting: {exc}") from exc


def set_configured_prompt(path: Path, value: str, prefix: str) -> str:
    value = validate_harness_prompt(value)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=prefix, delete=False
    ) as handle:
        handle.write(value + "\n")
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    try:
        temporary.chmod(0o600)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)
    return value


def project_prompt_path(root: Path, target: Path) -> Path:
    return root / f"{hashlib.sha256(str(target).encode()).hexdigest()}.txt"


def configured_project_prompt(
    path: Path, project_root: Path, default: str, label: str, target: Path | None = None,
) -> str:
    fallback = configured_prompt(path, default, label)
    if target is None:
        return fallback
    return configured_prompt(project_prompt_path(project_root, target), fallback, f"project {label}")


def prompt_setting(
    args, path: Path, project_root: Path, default: str, label: str,
) -> int:
    target = Path(args.target).resolve() if args.target else None
    if target is not None and (not target.is_dir() or not saved_project(target)):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    setting_path = project_prompt_path(project_root, target) if target else path
    try:
        if args.set_stdin:
            prompt = set_configured_prompt(setting_path, sys.stdin.read(), f".{label}-prompt.")
            source = "project" if target else "custom"
        elif args.reset:
            setting_path.unlink(missing_ok=True)
            prompt = configured_project_prompt(path, project_root, default, label, target)
            source = "inherited" if target else "default"
        else:
            prompt = configured_project_prompt(path, project_root, default, label, target)
            source = (
                "project" if target and setting_path.exists()
                else "inherited" if target
                else "custom" if path.exists()
                else "default"
            )
    except (OSError, RuntimeError, ValueError) as exc:
        raise SystemExit(str(exc)) from exc
    result = {
        "schemaVersion": 1, "prompt": prompt, "source": source,
        "isDefault": source in {"default", "inherited"},
        "targetPath": str(target) if target else None,
    }
    print(json.dumps(result) if args.json else prompt)
    return 0


def standard_harness_prompt(target: Path | None = None) -> str:
    return configured_project_prompt(
        HARNESS_PROMPT_PATH, HARNESS_PROJECT_PROMPT_ROOT,
        DEFAULT_HARNESS_PROMPT, "harness", target,
    )


def efficiency_harness_prompt(target: Path | None = None) -> str:
    return configured_project_prompt(
        EFFICIENCY_PROMPT_PATH, EFFICIENCY_PROJECT_PROMPT_ROOT,
        DEFAULT_EFFICIENCY_PROMPT, "efficiency", target,
    )


class DispatchInterrupted(Exception):
    def __init__(self, signum: int, target_interrupt_acknowledged: bool = False):
        super().__init__(f"interrupted by signal {signum}")
        self.signum = signum
        self.target_interrupt_acknowledged = target_interrupt_acknowledged


def atomic_write(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    rendered = json.dumps(payload, indent=2) + "\n"
    with tempfile.NamedTemporaryFile("w", dir=path.parent, prefix=f".{path.name}.", delete=False) as handle:
        handle.write(rendered)
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    os.replace(temporary, path)
    os.chmod(path, 0o600)


def canonical_json(payload: dict) -> str:
    return json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def runtime_revision() -> str:
    root = Path(__file__).resolve().parents[1]
    if len(root.name) == 40 and all(character in "0123456789abcdef" for character in root.name):
        return root.name
    completed = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "HEAD"], capture_output=True, text=True, check=False,
    )
    revision = completed.stdout.strip()
    return revision if len(revision) == 40 else "unknown"


def doctrine_sha256() -> str | None:
    try:
        return hashlib.sha256(DOCTRINE.read_bytes()).hexdigest()
    except OSError:
        return None


def harness_episode_id(identity: dict) -> tuple[str, str]:
    digest = hashlib.sha256(canonical_json(identity).encode()).hexdigest()
    return f"darkexec-harness-{digest[:32]}", digest


def write_harness_episode_once(payload: dict) -> Path:
    """Publish one immutable terminal episode without replacing prior evidence."""
    path = HARNESS_EPISODE_ROOT / f"{hashlib.sha256(payload['jobId'].encode()).hexdigest()}.json"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    rendered = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    if path.exists():
        existing = load_receipt(path)
        if (
            existing.get("jobId") != payload.get("jobId")
            or existing.get("episodeDigest") != payload.get("episodeDigest")
        ):
            raise RuntimeError(f"harness episode identity conflict: {payload['jobId']}")
        return path
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        handle.write(rendered)
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    os.chmod(temporary, 0o600)
    try:
        os.link(temporary, path)
    except FileExistsError:
        existing = load_receipt(path)
        if (
            existing.get("jobId") != payload.get("jobId")
            or existing.get("episodeDigest") != payload.get("episodeDigest")
        ):
            raise RuntimeError(f"harness episode identity conflict: {payload['jobId']}")
    finally:
        temporary.unlink(missing_ok=True)
    return path


def emit_harness_episode(
    *, lifecycle: str, target_path: str, harness_mode: str, status: str,
    target: dict, harness: dict, source: dict, generation: int | None = None,
    configuration: dict | None = None,
) -> tuple[str | None, str | None]:
    """Best-effort one-way journal emission; failure never changes target execution."""
    requested_purpose = source.get("episodePurpose")
    if requested_purpose not in {"ordinary", "control", "fire_drill", "gym_meta"}:
        requested_purpose = None
    episode_purpose = requested_purpose or (
        "control" if harness_mode == "read-only" else "ordinary"
    )
    identity = {
        "lifecycle": lifecycle,
        "targetPath": target_path,
        "targetThreadId": target.get("threadId"),
        "productTurnId": target.get("turnId"),
        "harnessThreadId": harness.get("threadId"),
        "harnessTurnId": harness.get("turnId"),
        "generation": generation,
    }
    job_id, episode_digest = harness_episode_id(identity)
    configuration_revision = hashlib.sha256(
        canonical_json(configuration or {"lifecycle": lifecycle, "harnessMode": harness_mode}).encode()
    ).hexdigest()
    payload = {
        "schema": "darkexec.harness-episode/v1",
        "schemaVersion": 1,
        "jobId": job_id,
        "requestSha256": episode_digest,
        "episodeDigest": episode_digest,
        "targetPath": target_path,
        "status": status,
        "terminalAt": now(),
        "harnessMode": harness_mode,
        "episodePurpose": episode_purpose,
        "harnessLifecycle": lifecycle,
        "generation": generation,
        "runtimeRevision": runtime_revision(),
        "doctrineSha256": doctrine_sha256(),
        "configurationRevision": configuration_revision,
        "terminalIdentity": source,
        "target": {
            "threadId": target.get("threadId"),
            "turnId": target.get("turnId"),
            "usage": target.get("usage") or target.get("initialUsage"),
            "modelCallCount": target.get("modelCallCount"),
            "resultText": target.get("resultText"),
            "harness": {
                "status": harness.get("status") or "not_started",
                "threadId": harness.get("threadId"),
                "turnId": harness.get("turnId"),
                "usage": harness.get("usage"),
                "modelCallCount": harness.get("modelCallCount"),
                "resultText": harness.get("resultText"),
                "error": harness.get("error"),
            },
        },
    }
    try:
        return str(write_harness_episode_once(payload)), None
    except Exception as exc:  # journal availability is never an execution dependency
        return None, f"{type(exc).__name__}: {exc}"


def receipt_path(job_id: str) -> Path:
    return STATE_ROOT / f"{hashlib.sha256(job_id.encode()).hexdigest()}.json"

def session_path(thread_id: str) -> Path:
    return SESSION_ROOT / f"{hashlib.sha256(thread_id.encode()).hexdigest()}.json"

def execution_path(thread_id: str) -> Path:
    return EXECUTION_ROOT / f"{hashlib.sha256(thread_id.encode()).hexdigest()}.json"

def control_path(thread_id: str) -> Path:
    return CONTROL_ROOT / f"{hashlib.sha256(thread_id.encode()).hexdigest()}.sock"

def process_start_ticks(pid: int) -> int | None:
    try:
        raw = Path(f"/proc/{pid}/stat").read_text()
        fields = raw[raw.rfind(")") + 2:].split()
        if fields[0] == "Z":
            return None
        return int(fields[19])
    except (OSError, ValueError, IndexError):
        return None

def merge_state(current: dict, changes: dict) -> dict:
    for key, value in changes.items():
        if isinstance(value, dict) and isinstance(current.get(key), dict):
            current[key] = merge_state(dict(current[key]), value)
        else:
            current[key] = value
    return current

def update_execution(thread_id: str, changes: dict, create: bool = False) -> dict:
    path = execution_path(thread_id)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    lock_path = path.with_suffix(".lock")
    lock = lock_path.open("a+")
    os.chmod(lock_path, 0o600)
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if path.exists():
            current = load_receipt(path)
        elif create:
            current = {"schemaVersion": 1, "executiveThreadId": thread_id}
        else:
            raise FileNotFoundError(path)
        current = merge_state(current, changes)
        current["updatedAt"] = now()
        atomic_write(path, current)
        return current
    finally:
        lock.close()

def read_execution(thread_id: str) -> dict:
    path = execution_path(thread_id)
    if not path.exists():
        return {
            "schemaVersion": 1,
            "executiveThreadId": thread_id,
            "status": "not_found",
            "phase": "idle",
            "runnerActive": False,
            "target": {},
        }
    lock_path = path.with_suffix(".lock")
    lock = lock_path.open("a+")
    os.chmod(lock_path, 0o600)
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_SH)
        state = load_receipt(path)
    finally:
        lock.close()
    runner = state.get("runner") if isinstance(state.get("runner"), dict) else {}
    pid = int(runner.get("pid") or 0)
    return {
        "schemaVersion": 1,
        "executiveThreadId": thread_id,
        "status": state.get("status") or "unknown",
        "phase": state.get("phase") or "unknown",
        "mode": state.get("mode"),
        "targetPath": state.get("targetPath"),
        "runnerActive": bool(pid and process_start_ticks(pid) == runner.get("startTicks")),
        "target": {
            key: value
            for key, value in (state.get("target") or {}).items()
            if key in {"threadId", "turnId"} and value
        },
        "error": state.get("error"),
        "createdAt": state.get("createdAt"),
        "updatedAt": state.get("updatedAt"),
    }

def begin_execution(
    thread_id: str | None,
    target: Path,
    mode: str,
    target_thread_id: str | None = None,
) -> dict | None:
    if not thread_id:
        return None
    path = execution_path(thread_id)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    lock_path = path.with_suffix(".lock")
    lock = lock_path.open("a+")
    os.chmod(lock_path, 0o600)
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        prior = load_receipt(path) if path.exists() else {
            "schemaVersion": 1, "executiveThreadId": thread_id,
        }
        runner = prior.get("runner") if isinstance(prior.get("runner"), dict) else {}
        if prior.get("status") in {"active", "stopping", "stop_partial"} and (
            process_start_ticks(int(runner.get("pid") or 0)) == runner.get("startTicks")
        ):
            raise SystemExit(f"executive task already owns an active DarkExec run: {thread_id}")
        prior_target = (prior.get("target") or {}).get("threadId")
        if mode == "continue" and prior.get("status") in {
            "interrupted", "stop_partial", "stopping",
        }:
            raise SystemExit(
                f"executive task {thread_id} has an interrupted target lineage and cannot continue it"
            )
        if mode == "initial" and prior_target:
            raise SystemExit(
                f"executive task {thread_id} is already bound to target {prior_target}; use darkexec continue"
            )
        if target_thread_id and prior_target and target_thread_id != prior_target:
            raise SystemExit(
                f"executive task {thread_id} is bound to target {prior_target}, not {target_thread_id}"
            )
        if prior.get("targetPath") and prior_target and prior.get("targetPath") != str(target):
            raise SystemExit(
                f"executive task {thread_id} is bound to project {prior['targetPath']}, not {target}"
            )
        pid = os.getpid()
        state = merge_state(prior, {
            "targetPath": str(target),
            "mode": mode,
            "status": "active",
            "phase": "starting",
            "runner": {"pid": pid, "startTicks": process_start_ticks(pid)},
            "target": {"threadId": target_thread_id} if target_thread_id else {},
            "stopRequestedAt": None,
            "stopMode": None,
            "stopResult": None,
            "targetInterruptAcknowledged": None,
            "error": None,
            "runStartedAt": now(),
            "createdAt": prior.get("createdAt") or now(),
        })
        state["updatedAt"] = now()
        atomic_write(path, state)
        return state
    finally:
        lock.close()

def load_receipt(path: Path) -> dict:
    return json.loads(path.read_text())

def receipt_runner_active(path: Path) -> bool:
    lock_path = path.with_suffix(".lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = lock_path.open("a+")
    try:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        return False
    finally:
        lock.close()

def wait_for_receipt(path: Path) -> dict:
    terminal = {"completed", "failed", "interrupted"}
    while True:
        receipt = load_receipt(path)
        if receipt.get("status") in terminal:
            return receipt
        if not receipt_runner_active(path):
            receipt = load_receipt(path)
            if receipt.get("status") in terminal:
                return receipt
            abandoned = dict(receipt)
            abandoned["receiptStatus"] = receipt.get("status")
            abandoned["status"] = "abandoned"
            abandoned["error"] = "nonterminal receipt has no active dispatch owner"
            return abandoned
        time.sleep(0.25)

def saved_project(path: Path) -> bool:
    try:
        config = tomllib.loads(CONFIG.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return False
    return str(path) in (config.get("projects") or {})


def saved_projects() -> list[str]:
    try:
        config = tomllib.loads(CONFIG.read_text())
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise SystemExit(f"cannot read saved Codex projects: {exc}") from exc
    projects = config.get("projects") or {}
    if not isinstance(projects, dict):
        raise SystemExit("cannot read saved Codex projects: projects must be a table")
    return sorted(path for path in projects if isinstance(path, str) and Path(path).is_absolute())


def usage(raw: dict | None) -> dict:
    raw = raw or {}
    return {
        "input": int(raw.get("inputTokens") or raw.get("input_tokens") or 0),
        "cacheRead": int(raw.get("cachedInputTokens") or raw.get("cached_input_tokens") or 0),
        "output": int(raw.get("outputTokens") or raw.get("output_tokens") or 0),
        "reasoningOutput": int(raw.get("reasoningOutputTokens") or raw.get("reasoning_output_tokens") or 0),
        "total": int(raw.get("totalTokens") or raw.get("total_tokens") or 0),
    }


def usage_delta(after: dict, before: dict) -> dict:
    return {key: max(0, int(after.get(key) or 0) - int(before.get(key) or 0)) for key in after}


def usage_add(total: dict, increment: dict) -> dict:
    return {key: int(total.get(key) or 0) + int(increment.get(key) or 0) for key in total}

class SteerControl:
    def __init__(self, executive_thread_id: str):
        self.path = control_path(executive_thread_id)
        self.listener: socket.socket | None = None

    def open(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(self.path.parent, 0o700)
        try:
            self.path.unlink()
        except FileNotFoundError:
            pass
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(str(self.path))
        os.chmod(self.path, 0o600)
        listener.listen(8)
        listener.setblocking(False)
        self.listener = listener

    def accept(self) -> list[tuple[socket.socket, dict]]:
        accepted = []
        if not self.listener:
            return accepted
        while True:
            try:
                connection, _ = self.listener.accept()
            except BlockingIOError:
                return accepted
            try:
                connection.settimeout(0.2)
                raw = connection.recv(65537)
                if len(raw) > 65536:
                    raise ValueError("steer request is too large")
                request = json.loads(raw)
                if not isinstance(request, dict):
                    raise ValueError("steer request must be an object")
                accepted.append((connection, request))
            except (OSError, ValueError, json.JSONDecodeError) as exc:
                self.respond(connection, {"status": "rejected", "error": str(exc)})

    @staticmethod
    def respond(connection: socket.socket, payload: dict) -> None:
        try:
            connection.sendall((json.dumps(payload) + "\n").encode())
        except OSError:
            pass
        finally:
            connection.close()

    def close(self) -> None:
        if self.listener:
            self.listener.close()
            self.listener = None
        try:
            self.path.unlink()
        except FileNotFoundError:
            pass

class AppServer:
    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(str(APP_SERVER_SOCKET))
        self.buffer = b""
        key = base64.b64encode(os.urandom(16)).decode()
        request = (
            "GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\n"
            f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        ).encode()
        self.sock.sendall(request)
        deadline = time.monotonic() + 5
        while b"\r\n\r\n" not in self.buffer:
            self.buffer += self._read_socket(deadline)
        headers, self.buffer = self.buffer.split(b"\r\n\r\n", 1)
        expected = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest())
        if b" 101 " not in headers or b"sec-websocket-accept: " + expected.lower() not in headers.lower():
            raise RuntimeError(f"App Server WebSocket upgrade failed: {headers[:500]!r}")
        self.request_id = 0
        self.thread_usage: dict[str, dict] = {}
        self.active_turn: tuple[str, str] | None = None
        self.signal_handlers = {
            signum: signal.signal(signum, self._handle_signal)
            for signum in (signal.SIGTERM, signal.SIGINT)
        }
        self._request("initialize", {
            "clientInfo": {"name": "darkexec", "version": "1"},
            "capabilities": {
                "experimentalApi": True,
                "optOutNotificationMethods": [
                    "item/agentMessage/delta", "item/reasoning/textDelta",
                    "item/reasoning/summaryTextDelta", "item/commandExecution/outputDelta",
                ],
            },
        })
        self._send({"jsonrpc": "2.0", "method": "initialized", "params": {}})

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()

    def _handle_signal(self, signum, _frame) -> None:
        acknowledged = self.interrupt_active()
        raise DispatchInterrupted(signum, acknowledged)

    def _send(self, payload: dict) -> None:
        self._send_frame(json.dumps(payload).encode())

    def _read_socket(self, deadline: float | None) -> bytes:
        remaining = None if deadline is None else deadline - time.monotonic()
        if remaining is not None and remaining <= 0:
            raise TimeoutError("App Server response timeout")
        if not select.select([self.sock], [], [], remaining)[0]:
            raise TimeoutError("App Server response timeout")
        chunk = self.sock.recv(65536)
        if not chunk:
            raise RuntimeError("App Server WebSocket closed unexpectedly")
        return chunk

    def _take(self, count: int, deadline: float | None) -> bytes:
        while len(self.buffer) < count:
            self.buffer += self._read_socket(deadline)
        value, self.buffer = self.buffer[:count], self.buffer[count:]
        return value

    def _send_frame(self, payload: bytes, opcode: int = 1) -> None:
        mask = os.urandom(4)
        length = len(payload)
        header = bytes([0x80 | opcode])
        if length < 126:
            header += bytes([0x80 | length])
        elif length < 65536:
            header += bytes([0x80 | 126]) + struct.pack("!H", length)
        else:
            header += bytes([0x80 | 127]) + struct.pack("!Q", length)
        masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
        self.sock.sendall(header + mask + masked)

    def _next(self, deadline: float | None) -> dict:
        fragments = bytearray()
        while True:
            first, second = self._take(2, deadline)
            opcode, masked = first & 0x0F, bool(second & 0x80)
            length = second & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._take(2, deadline))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._take(8, deadline))[0]
            mask = self._take(4, deadline) if masked else b""
            payload = self._take(length, deadline)
            if masked:
                payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
            if opcode == 8:
                raise RuntimeError("App Server WebSocket closed")
            if opcode == 9:
                self._send_frame(payload, opcode=10)
                continue
            if opcode not in {0, 1}:
                continue
            fragments.extend(payload)
            if first & 0x80:
                return json.loads(fragments.decode())

    def _request(self, method: str, params: dict, timeout: int = 30) -> dict:
        self.request_id += 1
        request_id = self.request_id
        self._send({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
        deadline = time.monotonic() + timeout
        while True:
            message = self._next(deadline)
            if message.get("id") != request_id:
                continue
            if message.get("error"):
                raise RuntimeError(str(message["error"]))
            return message.get("result") or {}

    def start_thread(self, cwd: Path) -> dict:
        result = self._request("thread/start", {
            "cwd": str(cwd), "approvalPolicy": "never", "sandbox": "danger-full-access",
            "ephemeral": False, "threadSource": "darkexec",
        })
        thread = result.get("thread") if isinstance(result.get("thread"), dict) else {}
        if not thread.get("id"):
            raise RuntimeError("App Server did not return a thread identity")
        return thread

    def require_listed_thread(self, thread_id: str, cwd: Path) -> dict:
        listed = self._request("thread/list", {"cwd": str(cwd), "sourceKinds": ["vscode"], "limit": 100,
                                                "sortKey": "created_at", "sortDirection": "desc",
                                                "useStateDbOnly": True})
        match = next((item for item in listed.get("data", []) if item.get("id") == thread_id
                      and item.get("cwd") == str(cwd) and item.get("source") == "vscode"), None)
        if not match:
            raise RuntimeError(f"Task {thread_id} was not listed by the running Codex App.")
        return match

    def read_thread(self, thread_id: str) -> dict:
        result = self._request("thread/read", {"threadId": thread_id, "includeTurns": True})
        thread = result.get("thread") if isinstance(result.get("thread"), dict) else {}
        if thread.get("id") != thread_id:
            raise RuntimeError(f"App Server did not return target task {thread_id}")
        return thread

    def resume_thread(self, thread_id: str, rollout_path: str | None = None) -> dict:
        params = {"threadId": thread_id}
        if rollout_path:
            params["path"] = rollout_path
        result = self._request("thread/resume", params)
        thread = result.get("thread") if isinstance(result.get("thread"), dict) else {}
        if thread.get("id") != thread_id:
            raise RuntimeError(f"App Server did not resume target task {thread_id}")
        return thread

    def require_resumed_thread(self, thread_id: str, cwd: Path) -> dict:
        listed = self.require_listed_thread(thread_id, cwd)
        rollout_path = listed.get("path")
        if rollout_path is not None and (
            not isinstance(rollout_path, str) or not Path(rollout_path).is_absolute()
        ):
            raise RuntimeError(f"Task {thread_id} has an invalid persisted rollout path.")
        thread = self.resume_thread(thread_id, rollout_path)
        if rollout_path:
            thread["_rolloutPath"] = rollout_path
        return thread

    def run_turn(
        self,
        thread_id: str,
        prompt: str,
        on_started=None,
        input_items: list[dict] | None = None,
        steer_key: str | None = None,
    ) -> dict:
        turn_input = input_items if input_items is not None else [{"type": "text", "text": prompt}]
        self.request_id += 1
        request_id = self.request_id
        self._send({
            "jsonrpc": "2.0", "id": request_id, "method": "turn/start",
            "params": {"threadId": thread_id, "input": turn_input},
        })
        deadline = time.monotonic() + TURN_TIMEOUT if TURN_TIMEOUT > 0 else None
        turn_id = None
        messages: list[str] = []
        final_usage = None
        turn_usage = {key: 0 for key in usage({})}
        saw_last_usage = False
        model_calls = 0
        control = SteerControl(steer_key) if steer_key else None
        pending_steers: dict[int, socket.socket] = {}
        reconcile_request_id = None
        reconcile_due = time.monotonic() + 2

        def completed_result(turn: dict) -> dict:
            previous = self.thread_usage.get(thread_id, {key: 0 for key in usage({})})
            current = final_usage or previous
            measured = turn_usage if saw_last_usage else usage_delta(current, previous)
            self.thread_usage[thread_id] = current
            result_text = messages[-1] if messages else ""
            ok = turn.get("status") == "completed" and bool(result_text)
            self.active_turn = None
            return {
                "ok": ok, "timedOut": False, "exitCode": 0 if ok else 1,
                "threadId": thread_id, "turnId": turn_id,
                "resultText": result_text[:12000],
                "usage": measured,
                "modelCallCount": model_calls or None,
                "error": "" if ok else str(
                    turn.get("error") or "App task failed without a final response"
                ),
            }

        try:
            if control:
                control.open()
            while True:
                if self.buffer:
                    message = self._next(deadline)
                else:
                    remaining = max(0, reconcile_due - time.monotonic())
                    if deadline is not None:
                        remaining = min(remaining, max(0, deadline - time.monotonic()))
                    readers = [self.sock]
                    if control and control.listener:
                        readers.append(control.listener)
                    readable = select.select(readers, [], [], remaining)[0]
                    if not readable:
                        if deadline is not None and time.monotonic() >= deadline:
                            raise TimeoutError("App Server response timeout")
                        if reconcile_request_id is None and turn_id:
                            self.request_id += 1
                            reconcile_request_id = self.request_id
                            self._send({
                                "jsonrpc": "2.0", "id": reconcile_request_id,
                                "method": "thread/read",
                                "params": {"threadId": thread_id, "includeTurns": True},
                            })
                        reconcile_due = time.monotonic() + 2
                        continue
                    message = self._next(deadline) if self.sock in readable else None
                if control:
                    for connection, request in control.accept():
                        if (
                            request.get("threadId") != thread_id
                            or request.get("expectedTurnId") != turn_id
                            or not isinstance(request.get("body"), str)
                            or not request["body"].strip()
                            or len(request["body"]) > 20000
                        ):
                            control.respond(connection, {
                                "status": "rejected",
                                "error": "active target identity does not match the steer request",
                            })
                            continue
                        try:
                            steer_input = normalize_input_items(
                                request.get("inputItems") or [{
                                    "type": "text", "text": request["body"],
                                }],
                                request["body"],
                                "steer request",
                            )
                        except RuntimeError as exc:
                            control.respond(connection, {
                                "status": "rejected", "error": str(exc),
                            })
                            continue
                        self.request_id += 1
                        steer_request_id = self.request_id
                        pending_steers[steer_request_id] = connection
                        self._send({
                            "jsonrpc": "2.0", "id": steer_request_id, "method": "turn/steer",
                            "params": {
                                "threadId": thread_id,
                                "expectedTurnId": turn_id,
                                "input": steer_input,
                                "clientUserMessageId": request.get("intentId"),
                            },
                        })
                    if message is None:
                        continue
                if message is None:
                    continue
                if message.get("id") == request_id:
                    if message.get("error"):
                        raise RuntimeError(str(message["error"]))
                    turn_id = ((message.get("result") or {}).get("turn") or {}).get("id")
                    if turn_id:
                        self.active_turn = (thread_id, turn_id)
                        if on_started:
                            on_started(thread_id, turn_id)
                    continue
                if message.get("id") in pending_steers:
                    connection = pending_steers.pop(message["id"])
                    if message.get("error"):
                        control.respond(connection, {
                            "status": "rejected", "error": str(message["error"]),
                        })
                    else:
                        response_turn = (message.get("result") or {}).get("turnId")
                        control.respond(connection, {
                            "status": "acknowledged",
                            "threadId": thread_id,
                            "turnId": response_turn,
                        })
                    continue
                if reconcile_request_id is not None and message.get("id") == reconcile_request_id:
                    reconcile_request_id = None
                    if not message.get("error"):
                        thread = (message.get("result") or {}).get("thread") or {}
                        turn = next(
                            (
                                candidate for candidate in thread.get("turns", [])
                                if candidate.get("id") == turn_id
                            ),
                            None,
                        )
                        if turn and turn.get("status") != "inProgress":
                            for item in turn.get("items", []):
                                if item.get("type") == "agentMessage" and item.get("text"):
                                    text = str(item["text"])
                                    if not messages or messages[-1] != text:
                                        messages.append(text)
                            return completed_result(turn)
                    reconcile_due = time.monotonic() + 2
                    continue
                method = message.get("method")
                params = message.get("params") if isinstance(message.get("params"), dict) else {}
                if params.get("threadId") != thread_id:
                    continue
                if method == "item/completed":
                    item = params.get("item") if isinstance(params.get("item"), dict) else {}
                    if item.get("type") == "agentMessage" and item.get("text"):
                        messages.append(str(item["text"]))
                elif method == "thread/tokenUsage/updated" and (not turn_id or params.get("turnId") == turn_id):
                    token_usage = params.get("tokenUsage") if isinstance(params.get("tokenUsage"), dict) else {}
                    final_usage = usage(token_usage.get("total") if isinstance(token_usage.get("total"), dict) else {})
                    if isinstance(token_usage.get("last"), dict):
                        turn_usage = usage_add(turn_usage, usage(token_usage["last"]))
                        saw_last_usage = True
                    model_calls += 1
                elif method == "turn/completed":
                    turn = params.get("turn") if isinstance(params.get("turn"), dict) else {}
                    if not turn_id or turn.get("id") != turn_id:
                        continue
                    return completed_result(turn)
        except TimeoutError:
            self.interrupt_active()
            return {
                "ok": False, "timedOut": True, "exitCode": None, "threadId": thread_id,
                "error": f"Codex App turn exceeded {TURN_TIMEOUT} seconds.",
            }
        finally:
            for connection in pending_steers.values():
                if control:
                    control.respond(connection, {
                        "status": "rejected", "error": "target turn ended before steer acknowledgement",
                    })
            if control:
                control.close()

    def interrupt_active(self) -> bool:
        if not self.active_turn:
            return False
        thread_id, turn_id = self.active_turn
        try:
            self._request("turn/interrupt", {"threadId": thread_id, "turnId": turn_id}, timeout=5)
            acknowledged = True
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError):
            acknowledged = False
        self.active_turn = None
        return acknowledged

    def interrupt_turn(self, thread_id: str, turn_id: str) -> None:
        self._request("turn/interrupt", {"threadId": thread_id, "turnId": turn_id}, timeout=5)

    def stop(self) -> None:
        try:
            self._send_frame(b"", opcode=8)
        except OSError:
            pass

    def close(self) -> None:
        self.stop()
        self.sock.close()
        for signum, handler in self.signal_handlers.items():
            signal.signal(signum, handler)


def add_usage(receipt: dict) -> None:
    entries = [
        (receipt.get("executive") or {}).get("initialUsage"),
        (receipt.get("executive") or {}).get("closeoutUsage"),
        (receipt.get("target") or {}).get("initialUsage"),
        ((receipt.get("target") or {}).get("harness") or {}).get("usage"),
    ]
    totals = {key: 0 for key in ("input", "cacheRead", "output", "reasoningOutput", "total")}
    for entry in entries:
        if isinstance(entry, dict):
            for key in totals:
                totals[key] += int(entry.get(key) or 0)
    receipt["cumulativeUsage"] = totals


def save(path: Path, receipt: dict, status: str) -> None:
    receipt["status"] = status
    receipt["updatedAt"] = now()
    add_usage(receipt)
    atomic_write(path, receipt)


def closeout_executive(receipt: dict, path: Path, app: AppServer) -> None:
    thread_id = (receipt.get("executive") or {}).get("threadId")
    if not thread_id:
        return
    thread = app.read_thread(thread_id)
    existing_turn_ids = {
        turn.get("id") for turn in thread.get("turns", []) if turn.get("id")
    }
    if active_turn_id(thread):
        receipt["executive"]["closeoutStatus"] = "suppressed_active_user_turn"
        save(path, receipt, receipt["status"])
        return
    target_id = (receipt.get("target") or {}).get("threadId") or "unavailable"
    prompt = (
        f"DarkExec job {receipt['jobId']} reached {receipt['status']}. Target task: {target_id}. "
        f"Same-task harness: {((receipt.get('target') or {}).get('harness') or {}).get('status', 'not_started')}. "
        "Do not inspect or change anything. Reply with those identities and statuses only."
    )
    try:
        result = app.run_turn(thread_id, prompt)
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError):
        latest = app.read_thread(thread_id)
        new_turns = [
            turn for turn in latest.get("turns", [])
            if turn.get("id") and turn.get("id") not in existing_turn_ids
        ]
        if new_turns:
            receipt["executive"]["closeoutStatus"] = "suppressed_user_activity"
            save(path, receipt, receipt["status"])
            return
        raise
    receipt["executive"]["closeoutUsage"] = result.get("usage")
    receipt["executive"]["closeoutModelCallCount"] = result.get("modelCallCount")
    receipt["executive"]["closeoutResult"] = result.get("resultText")
    receipt["executive"]["closeoutStatus"] = "completed" if result.get("ok") else "failed"
    save(path, receipt, receipt["status"])


def resolved_route(result_text: str, job_id: str, projects: list[str]) -> Path:
    prefix = f"DARKEXEC_ROUTE_READY {job_id} "
    if not result_text.startswith(prefix) or "\n" in result_text:
        raise RuntimeError("DarkExec target resolver returned an invalid acknowledgement")
    value = result_text[len(prefix):]
    if value not in projects:
        raise RuntimeError("DarkExec target resolver returned an unsaved project")
    target = Path(value).resolve()
    if target == WORKSPACE.resolve():
        raise RuntimeError("DarkExec target resolver selected its own executive workspace")
    return target


def global_route_candidates(path: Path) -> list[dict]:
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read global route candidates: {exc}") from exc
    if not isinstance(payload, list) or not payload or len(payload) > 500:
        raise RuntimeError("global route candidates must contain 1 to 500 entries")
    candidates = []
    seen = set()
    for item in payload:
        if not isinstance(item, dict):
            raise RuntimeError("global route candidates must be objects")
        host_id = item.get("hostId")
        target_path = item.get("targetPath")
        host_label = item.get("hostLabel")
        if (
            not isinstance(host_id, str) or not 8 <= len(host_id) <= 128
            or any(character not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" for character in host_id)
        ):
            raise RuntimeError("global route candidate hostId is invalid")
        if (
            not isinstance(target_path, str) or not Path(target_path).is_absolute()
            or len(target_path) > 4096
        ):
            raise RuntimeError("global route candidate targetPath is invalid")
        if not isinstance(host_label, str) or not host_label.strip() or len(host_label) > 120:
            raise RuntimeError("global route candidate hostLabel is invalid")
        identity = (host_id, target_path)
        if identity in seen:
            raise RuntimeError("global route candidates contain a duplicate host and project")
        seen.add(identity)
        candidates.append({
            "hostId": host_id,
            "hostLabel": host_label.strip(),
            "targetPath": target_path,
        })
    return candidates


def resolved_global_route(result_text: str, job_id: str, candidates: list[dict]) -> dict:
    prefix = f"DARKEXEC_GLOBAL_ROUTE_READY {job_id} "
    if not result_text.startswith(prefix) or "\n" in result_text:
        raise RuntimeError("DarkExec global resolver returned an invalid acknowledgement")
    try:
        selected = json.loads(result_text[len(prefix):])
    except json.JSONDecodeError as exc:
        raise RuntimeError("DarkExec global resolver returned invalid JSON") from exc
    identity = (selected.get("hostId"), selected.get("targetPath")) if isinstance(selected, dict) else None
    allowed = {(item["hostId"], item["targetPath"]) for item in candidates}
    if identity not in allowed:
        raise RuntimeError("DarkExec global resolver returned an unknown host or project")
    return next(item for item in candidates if (item["hostId"], item["targetPath"]) == identity)


def resolve_global(args) -> int:
    prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("resolve-global requires a non-empty prompt on stdin")
    try:
        candidates = global_route_candidates(Path(args.candidates_json))
    except RuntimeError as exc:
        raise SystemExit(str(exc)) from exc
    request_sha = hashlib.sha256(
        prompt.encode() + b"\0" + canonical_json({"candidates": candidates}).encode()
    ).hexdigest()
    path = receipt_path(f"global-route:{args.job_id}")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = path.with_suffix(".lock").open("a+")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if path.exists():
            print(json.dumps(load_receipt(path)))
        else:
            print(json.dumps({"jobId": args.job_id, "status": "starting"}))
        return 1
    if path.exists():
        prior = load_receipt(path)
        if prior.get("requestSha256") != request_sha:
            raise SystemExit("global route job id already belongs to different input")
        print(json.dumps(prior) if args.json else prior.get("targetPath", ""))
        return 0 if prior.get("status") == "completed" else 1
    receipt = {
        "schemaVersion": 1,
        "jobId": args.job_id,
        "requestSha256": request_sha,
        "transport": "codex-app-server-control-socket",
        "createdAt": now(),
        "executive": {},
    }
    save(path, receipt, "routing")
    control_prompt = (
        f"DARKEXEC GLOBAL ROUTE TASK. Select the one exact host and saved project that owns job {args.job_id}. "
        f"Allowed candidates: {json.dumps(candidates)}. Natural request: {json.dumps(prompt)}. "
        "Use only the supplied request and candidate metadata. Do not inspect files, use tools, start "
        "DarkExec, or perform the work. Reply only: "
        f"DARKEXEC_GLOBAL_ROUTE_READY {args.job_id} "
        '{"hostId":"exact-host-id","targetPath":"/exact/saved/project"}'
    )
    try:
        with AppServer() as app:
            thread = app.start_thread(WORKSPACE)
            result = app.run_turn(thread["id"], control_prompt)
            listed = app.require_listed_thread(thread["id"], WORKSPACE)
            receipt["executive"] = {
                "threadId": listed["id"],
                "source": listed.get("source"),
                "appVisible": True,
                "listedCwd": listed.get("cwd"),
                "initialUsage": result.get("usage"),
                "initialModelCallCount": result.get("modelCallCount"),
                "initialResult": result.get("resultText"),
            }
            if not result.get("ok"):
                raise RuntimeError(result.get("error") or "global resolver did not complete")
            selected = resolved_global_route(result.get("resultText") or "", args.job_id, candidates)
            receipt.update(selected)
            save(path, receipt, "completed")
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        receipt["error"] = f"Global target resolution failed: {exc}"
        save(path, receipt, "failed")
    print(json.dumps(receipt) if args.json else receipt.get("targetPath", ""))
    return 0 if receipt.get("status") == "completed" else 1


def dispatch(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir():
        raise SystemExit(f"target is not a directory: {target}")
    if not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    if args.resolve_target and target != WORKSPACE.resolve():
        raise SystemExit("--resolve-target requires the exact DarkExec executive workspace")
    prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("dispatch requires a non-empty prompt on stdin")
    path = receipt_path(args.job_id)
    try:
        direct_input = manifest_input(getattr(args, "input_json", None), prompt)
    except RuntimeError as exc:
        raise SystemExit(str(exc)) from exc
    request_material = prompt.encode()
    if direct_input is not None:
        request_material += b"\0" + json.dumps(
            direct_input, sort_keys=True, separators=(",", ":")
        ).encode()
    if args.resolve_target:
        request_material += b"\0resolve-target"
    request_sha = hashlib.sha256(request_material).hexdigest()
    harness_mode = "read-only" if args.read_only_harness else "standard"
    initial_harness_mode = "debounce" if args.defer_initial_harness else "immediate"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = path.with_suffix(".lock").open("a+")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if path.exists():
            current = load_receipt(path)
            print(json.dumps(current) if args.json else render_status(current))
        else:
            print(json.dumps({"jobId": args.job_id, "status": "starting"}) if args.json else f"{args.job_id}: starting")
        return 1
    if path.exists():
        prior = load_receipt(path)
        prior_requested_target = prior.get("requestedTargetPath", prior.get("targetPath"))
        if (
            prior.get("requestSha256") != request_sha
            or prior_requested_target != str(target)
            or bool(prior.get("targetResolution") == "executive") != bool(args.resolve_target)
        ):
            raise SystemExit("job id already belongs to a different request or target")
        if (
            prior.get("harnessMode", harness_mode) != harness_mode
            or prior.get("initialHarnessMode", initial_harness_mode) != initial_harness_mode
        ):
            raise SystemExit("job id already belongs to a different harness mode")
        print(json.dumps(prior) if args.json else render_status(prior))
        return 0 if prior.get("status") == "completed" else 1

    receipt = {
        "schemaVersion": 1, "jobId": args.job_id, "requestSha256": request_sha,
        "requestedTargetPath": str(target), "targetPath": str(target),
        "targetResolution": "executive" if args.resolve_target else "exact",
        "transport": "codex-app-server-control-socket",
        "harnessMode": harness_mode, "initialHarnessMode": initial_harness_mode,
        "createdAt": now(), "executive": {}, "target": {},
    }
    save(path, receipt, "registering")
    interrupted_exit = None
    route_projects = saved_projects() if args.resolve_target else []
    if args.resolve_target:
        control_prompt = (
            f"DARKEXEC ROUTE TASK. Select the one exact saved project that owns job {args.job_id}. "
            f"Allowed projects: {json.dumps(route_projects)}. "
            f"Natural request: {json.dumps(prompt)}. "
            "Use only the supplied request and attachments. Do not inspect files, use tools, start "
            "DarkExec, or perform the work. "
            f"Reply only: DARKEXEC_ROUTE_READY {args.job_id} /exact/saved/project"
        )
        control_input = [{"type": "text", "text": control_prompt}]
        if direct_input is not None:
            control_input.extend(
                item for item in direct_input if item.get("type") in {"image", "localImage"}
            )
    else:
        control_prompt = (
            f"DARKEXEC CONTROL TASK. Register job {args.job_id} for exact saved project {target}. "
            f"The target request SHA-256 is {request_sha}. Do not inspect files, use tools, or perform "
            f"the target work. Reply only: DARKEXEC_DISPATCH_READY {args.job_id}"
        )
        control_input = None
    try:
        with AppServer() as app:
            executive_thread = app.start_thread(WORKSPACE)
            executive = app.run_turn(
                executive_thread["id"], control_prompt, input_items=control_input
            )
            executive_thread = app.require_listed_thread(executive_thread["id"], WORKSPACE)
            receipt["executive"] = {
                "threadId": executive_thread["id"], "source": executive_thread.get("source"),
                "appVisible": True, "listedCwd": executive_thread.get("cwd"),
                "initialUsage": executive.get("usage"),
                "initialModelCallCount": executive.get("modelCallCount"),
                "initialResult": executive.get("resultText"),
            }
            if not executive.get("ok"):
                receipt["error"] = executive.get("error") or "DarkExec control task did not complete."
                save(path, receipt, "failed")
                print(json.dumps(receipt) if args.json else render_status(receipt))
                return 1
            if args.resolve_target:
                try:
                    target = resolved_route(
                        executive.get("resultText") or "", args.job_id, route_projects
                    )
                except RuntimeError as exc:
                    receipt["error"] = str(exc)
                    save(path, receipt, "failed")
                    print(json.dumps(receipt) if args.json else render_status(receipt))
                    return 1
                receipt["targetPath"] = str(target)
                receipt["resolvedTargetPath"] = str(target)
                save(path, receipt, "target_resolved")

            target_thread = app.start_thread(target)
            receipt["target"] = {
                "threadId": target_thread["id"], "source": target_thread.get("source"),
                "appVisible": False, "listedCwd": None,
                "harness": {"status": "not_started"},
            }
            save(path, receipt, "target_running")
            def target_started(_thread_id: str, turn_id: str) -> None:
                receipt["target"]["turnId"] = turn_id
                save(path, receipt, "target_running")
            target_result = app.run_turn(
                target_thread["id"], prompt, on_started=target_started,
                input_items=direct_input,
                steer_key=executive_thread["id"],
            )
            listed_target = app.require_listed_thread(target_thread["id"], target)
            receipt["target"].update({
                "source": listed_target.get("source"), "appVisible": True,
                "listedCwd": listed_target.get("cwd"),
                "initialUsage": target_result.get("usage"),
                "modelCallCount": target_result.get("modelCallCount"),
                "resultText": target_result.get("resultText"),
            })
            if not target_result.get("ok"):
                receipt["error"] = target_result.get("error") or "Target task failed before a durable result."
                save(path, receipt, "failed")
                closeout_executive(receipt, path, app)
                print(json.dumps(receipt) if args.json else render_status(receipt))
                return 1

            if args.defer_initial_harness:
                receipt["target"]["harness"] = {"status": "deferred"}
                save(path, receipt, "completed")
            else:
                save(path, receipt, "harness_running")
                harness_prompt = READ_ONLY_HARNESS_PROMPT if args.read_only_harness else standard_harness_prompt(target)
                def harness_started(_thread_id: str, turn_id: str) -> None:
                    receipt["target"]["harness"]["turnId"] = turn_id
                    save(path, receipt, "harness_running")
                harness = app.run_turn(target_thread["id"], harness_prompt, on_started=harness_started)
                receipt["target"]["harness"] = {
                    "status": "completed" if harness.get("ok") else "failed",
                    "turnId": harness.get("turnId"),
                    "usage": harness.get("usage"), "modelCallCount": harness.get("modelCallCount"),
                    "resultText": harness.get("resultText"), "error": harness.get("error") or None,
                }
                if not harness.get("ok"):
                    receipt["error"] = harness.get("error") or "Same-task harness turn failed."
                    save(path, receipt, "failed")
                else:
                    save(path, receipt, "completed")
            closeout_executive(receipt, path, app)
    except DispatchInterrupted as exc:
        receipt["error"] = str(exc)
        receipt["targetInterruptAcknowledged"] = exc.target_interrupt_acknowledged
        save(path, receipt, "interrupted")
        interrupted_exit = 128 + exc.signum
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        receipt["error"] = f"Native Codex App transport failed: {exc}"
        save(path, receipt, "failed")
    harness = (receipt.get("target") or {}).get("harness") or {"status": "not_started"}
    if not (args.defer_initial_harness and harness.get("status") == "deferred"):
        episode_path, episode_error = emit_harness_episode(
            lifecycle="immediate",
            target_path=receipt.get("targetPath") or str(target),
            harness_mode=harness_mode,
            status=receipt.get("status") or "failed",
            target=receipt.get("target") or {},
            harness=harness,
            source={
                "kind": "dispatch",
                "jobId": args.job_id,
                "initialHarnessMode": initial_harness_mode,
            },
            configuration={
                "command": "dispatch",
                "harnessMode": harness_mode,
                "initialHarnessMode": initial_harness_mode,
                "targetResolution": receipt.get("targetResolution"),
            },
        )
        receipt["harnessEpisode"] = {"path": episode_path, "error": episode_error}
        save(path, receipt, receipt.get("status") or "failed")
    print(json.dumps(receipt) if args.json else render_status(receipt))
    if interrupted_exit is not None:
        return interrupted_exit
    return 0 if receipt.get("status") == "completed" else 1


def requested_executive_thread(args) -> str | None:
    return getattr(args, "executive_thread", None) or os.environ.get("CODEX_THREAD_ID")

def executive_turn_input(app: AppServer, thread_id: str, prompt: str) -> list[dict]:
    thread = app.read_thread(thread_id)
    active_turns = [turn for turn in thread.get("turns", []) if turn.get("status") == "inProgress"]
    if len(active_turns) != 1:
        raise RuntimeError(
            f"Executive task {thread_id} must have exactly one active turn; found {len(active_turns)}."
        )
    content = [
        entry
        for item in active_turns[0].get("items", [])
        if item.get("type") == "userMessage"
        for entry in item.get("content", [])
    ]
    return normalize_input_items(content, prompt, "executive turn")


def normalize_input_items(
    content: object, prompt: str, source: str, require_local_files: bool = False
) -> list[dict]:
    if not isinstance(content, list) or not content or len(content) > 20:
        raise RuntimeError(f"{source} must contain between 1 and 20 input items")
    supported = {"text", "image", "localImage"}
    if any(not isinstance(entry, dict) for entry in content):
        raise RuntimeError(f"{source} input items must be objects")
    unsupported = sorted({
        str(entry.get("type")) for entry in content if entry.get("type") not in supported
    })
    if unsupported:
        raise RuntimeError(
            f"{source} contains unsupported input content: {', '.join(unsupported)}"
        )
    text_items = [
        str(entry.get("text") or "") for entry in content if entry.get("type") == "text"
    ]
    text = "\n".join(text_items)
    annotations = text.removeprefix(f"{prompt}\n\n").splitlines()
    annotations_match = (
        len(text_items) == 1
        and text.startswith(f"{prompt}\n\n")
        and bool(annotations)
        and all(
            (line.startswith('Attached image: "') and line.endswith('"'))
            or (line.startswith('Attached file: "') and '" at ' in line)
            for line in annotations
        )
    )
    if text != prompt and not annotations_match:
        raise RuntimeError(f"stdin prompt does not match the {source} text")
    normalized = []
    for entry in content:
        if entry.get("type") == "text":
            normalized.append({"type": "text", "text": str(entry.get("text") or "")})
        elif entry.get("type") == "image" and entry.get("url"):
            if len(str(entry["url"])) > 35_000_000:
                raise RuntimeError(f"{source} image exceeds the encoded size limit")
            image = {"type": "image", "url": entry["url"]}
            if entry.get("detail"):
                image["detail"] = entry["detail"]
            normalized.append(image)
        elif entry.get("type") == "localImage" and entry.get("path"):
            path = Path(str(entry["path"])).resolve()
            if require_local_files:
                if not path.is_file():
                    raise RuntimeError(f"{source} local image is not a file: {path}")
                if path.stat().st_size > 25 * 1024 * 1024:
                    raise RuntimeError(f"{source} local image exceeds 25 MiB: {path}")
            normalized.append({"type": "localImage", "path": str(path)})
        else:
            raise RuntimeError(f"{source} has an incomplete {entry.get('type')} input item")
    return normalized


def manifest_input(path_value: str | None, prompt: str) -> list[dict] | None:
    if not path_value:
        return None
    path = Path(path_value).resolve()
    if not path.is_file() or path.stat().st_size > 128 * 1024:
        raise RuntimeError(f"input manifest is unavailable or too large: {path}")
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read input manifest: {exc}") from exc
    content = payload.get("input") if isinstance(payload, dict) else None
    return normalize_input_items(content, prompt, "input manifest", require_local_files=True)


def requested_input(app: AppServer, args, executive_thread_id: str | None, prompt: str) -> list[dict] | None:
    if getattr(args, "source_executive_turn", False):
        if not executive_thread_id:
            raise RuntimeError("--source-executive-turn requires an executive task")
        return executive_turn_input(app, executive_thread_id, prompt)
    return manifest_input(getattr(args, "input_json", None), prompt)


def run_target(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir():
        raise SystemExit(f"target is not a directory: {target}")
    if not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("run requires a non-empty prompt on stdin")
    executive_thread_id = requested_executive_thread(args)
    harness_mode = "read-only" if args.read_only_harness else "standard"
    if args.source_executive_turn and not executive_thread_id:
        raise SystemExit("--source-executive-turn requires --executive-thread or CODEX_THREAD_ID")
    begin_execution(executive_thread_id, target, "initial")
    result = {
        "schemaVersion": 1, "targetPath": str(target),
        "transport": "codex-app-server-control-socket", "createdAt": now(),
        "executiveThreadId": executive_thread_id,
    }
    interrupted_exit = None
    try:
        with AppServer() as app:
            source_input = requested_input(app, args, executive_thread_id, prompt)
            thread = app.start_thread(target)
            result["target"] = {
                "threadId": thread["id"], "source": thread.get("source"),
                "appVisible": False, "listedCwd": None,
            }
            if executive_thread_id:
                update_execution(executive_thread_id, {
                    "phase": "target_starting",
                    "target": {
                        "threadId": thread["id"], "source": thread.get("source"),
                        "listedCwd": None,
                    },
                })
            def target_started(_thread_id: str, turn_id: str) -> None:
                result["target"]["turnId"] = turn_id
                if executive_thread_id:
                    update_execution(executive_thread_id, {
                        "phase": "target_running",
                        "target": {"threadId": thread["id"], "turnId": turn_id},
                    })
            target_result = app.run_turn(
                thread["id"], prompt, on_started=target_started, input_items=source_input,
                steer_key=executive_thread_id,
            )
            listed_thread = app.require_listed_thread(thread["id"], target)
            result["target"].update({
                "source": listed_thread.get("source"), "appVisible": True,
                "listedCwd": listed_thread.get("cwd"),
                "resultText": target_result.get("resultText"),
                "usage": target_result.get("usage"),
                "modelCallCount": target_result.get("modelCallCount"),
            })
            if not target_result.get("ok"):
                result["status"] = "failed"
                result["error"] = target_result.get("error") or "Target task failed."
            else:
                harness_prompt = READ_ONLY_HARNESS_PROMPT if args.read_only_harness else standard_harness_prompt(target)
                result["harness"] = {"status": "running"}
                if executive_thread_id:
                    update_execution(executive_thread_id, {"phase": "harness_starting"})
                def harness_started(_thread_id: str, turn_id: str) -> None:
                    result["harness"]["turnId"] = turn_id
                    if executive_thread_id:
                        update_execution(executive_thread_id, {
                            "phase": "harness_running",
                            "target": {"turnId": turn_id},
                        })
                harness = app.run_turn(thread["id"], harness_prompt, on_started=harness_started)
                result["harness"] = {
                    "status": "completed" if harness.get("ok") else "failed",
                    "turnId": harness.get("turnId"),
                    "resultText": harness.get("resultText"),
                    "usage": harness.get("usage"),
                    "modelCallCount": harness.get("modelCallCount"),
                    "error": harness.get("error") or None,
                }
                result["status"] = "completed" if harness.get("ok") else "failed"
                if not harness.get("ok"):
                    result["error"] = harness.get("error") or "Same-task harness turn failed."
    except DispatchInterrupted as exc:
        result["status"] = "interrupted"
        if (result.get("harness") or {}).get("turnId"):
            result["harness"]["status"] = "interrupted"
            result["harness"]["error"] = str(exc)
        result["error"] = str(exc)
        result["targetInterruptAcknowledged"] = exc.target_interrupt_acknowledged
        interrupted_exit = 128 + exc.signum
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        result["status"] = "failed"
        if (result.get("harness") or {}).get("turnId"):
            result["harness"]["status"] = "failed"
            result["harness"]["error"] = str(exc)
        result["error"] = f"Native Codex App transport failed: {exc}"
    if executive_thread_id:
        update_execution(executive_thread_id, {
            "status": result["status"],
            "phase": "idle",
            "runner": {"pid": None, "startTicks": None},
            "target": {
                "threadId": (result.get("target") or {}).get("threadId"),
                "turnId": (
                    (result.get("harness") or {}).get("turnId")
                    or (result.get("target") or {}).get("turnId")
                ),
            },
            "error": result.get("error"),
            "targetInterruptAcknowledged": result.get("targetInterruptAcknowledged"),
        })
    result["updatedAt"] = now()
    episode_path, episode_error = emit_harness_episode(
        lifecycle="immediate", target_path=str(target), harness_mode=harness_mode,
        status=result["status"], target=result.get("target") or {},
        harness=result.get("harness") or {"status": "not_started"},
        source={"kind": "interactive_run", "executiveThreadId": executive_thread_id},
        configuration={"command": "run", "harnessMode": harness_mode},
    )
    result["harnessEpisode"] = {"path": episode_path, "error": episode_error}
    print(json.dumps(result) if args.json else (
        f"{result['status']} target={(result.get('target') or {}).get('threadId') or '-'} "
        f"harness={(result.get('harness') or {}).get('status', 'not_started')}"
    ))
    if interrupted_exit is not None:
        return interrupted_exit
    return 0 if result.get("status") == "completed" else 1


def continue_target(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir():
        raise SystemExit(f"target is not a directory: {target}")
    if not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    prompt = sys.stdin.read()
    if not prompt.strip():
        raise SystemExit("continue requires a non-empty prompt on stdin")
    executive_thread_id = requested_executive_thread(args)
    if not executive_thread_id:
        raise SystemExit("continue requires --executive-thread or CODEX_THREAD_ID")
    begin_execution(executive_thread_id, target, "continue", args.thread)
    manual_harness_mode = (
        "efficiency" if args.harness_efficiency
        else "standard" if args.harness_standard
        else None if args.source_executive_turn
        else harness_prompt_mode(prompt)
    )
    manual_product: dict = {}
    manual_generation = None
    result = {
        "schemaVersion": 1, "executiveThreadId": executive_thread_id,
        "targetPath": str(target), "transport": "codex-app-server-control-socket",
        "target": {"threadId": args.thread}, "createdAt": now(),
    }
    interrupted_exit = None
    try:
        with AppServer() as app:
            source_input = requested_input(app, args, executive_thread_id, prompt)
            thread = app.require_resumed_thread(args.thread, target)
            if manual_harness_mode:
                turns = thread.get("turns") if isinstance(thread.get("turns"), list) else []
                for candidate in reversed(turns):
                    if user_text(candidate) and not harness_prompt_mode(user_text(candidate)):
                        manual_product = {
                            "threadId": args.thread,
                            "turnId": candidate.get("id"),
                            "resultText": agent_text(candidate) or None,
                        }
                        break
                closeout_path = session_path(args.thread)
                if closeout_path.exists():
                    closeout_state = load_receipt(closeout_path)
                    if closeout_state.get("productTurnId") == manual_product.get("turnId"):
                        manual_generation = closeout_state.get("generation")
            update_execution(executive_thread_id, {
                "phase": "target_starting",
                "target": {
                    "threadId": args.thread, "source": thread.get("source"),
                    "listedCwd": thread.get("cwd"),
                },
            })
            def turn_started(_thread_id: str, turn_id: str) -> None:
                result["target"]["turnId"] = turn_id
                update_execution(executive_thread_id, {
                    "phase": "target_running",
                    "target": {"threadId": args.thread, "turnId": turn_id},
                })
            turn = app.run_turn(
                args.thread, prompt, on_started=turn_started, input_items=source_input,
                steer_key=executive_thread_id,
            )
            result["target"].update({
                "source": thread.get("source"), "appVisible": True,
                "listedCwd": thread.get("cwd"), "resultText": turn.get("resultText"),
                "usage": turn.get("usage"), "modelCallCount": turn.get("modelCallCount"),
            })
            result["status"] = "completed" if turn.get("ok") else "failed"
            if not turn.get("ok"):
                result["error"] = turn.get("error") or "Target follow-up failed."
    except DispatchInterrupted as exc:
        result["status"] = "interrupted"
        result["error"] = str(exc)
        result["targetInterruptAcknowledged"] = exc.target_interrupt_acknowledged
        interrupted_exit = 128 + exc.signum
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        result["status"] = "failed"
        result["error"] = f"Native Codex App transport failed: {exc}"
    update_execution(executive_thread_id, {
        "status": result["status"], "phase": "idle",
        "runner": {"pid": None, "startTicks": None},
        "target": {
            "threadId": args.thread,
            "turnId": (result.get("target") or {}).get("turnId"),
        },
        "error": result.get("error"),
        "targetInterruptAcknowledged": result.get("targetInterruptAcknowledged"),
    })
    result["updatedAt"] = now()
    if manual_harness_mode:
        manual_harness = {
            "status": result["status"],
            "turnId": (result.get("target") or {}).get("turnId"),
            "resultText": (result.get("target") or {}).get("resultText"),
            "usage": (result.get("target") or {}).get("usage"),
            "modelCallCount": (result.get("target") or {}).get("modelCallCount"),
            "error": result.get("error"),
        }
        episode_path, episode_error = emit_harness_episode(
            lifecycle="manual", target_path=str(target), harness_mode=manual_harness_mode,
            status=result["status"], target=manual_product or {
                "threadId": args.thread, "turnId": None,
            }, harness=manual_harness, generation=manual_generation,
            source={
                "kind": "interactive_manual",
                "executiveThreadId": executive_thread_id,
                "targetThreadId": args.thread,
            },
            configuration={"command": "continue", "harnessMode": manual_harness_mode},
        )
        result["harnessEpisode"] = {"path": episode_path, "error": episode_error}
    print(json.dumps(result) if args.json else (
        f"{result['status']} target={args.thread} "
        f"turn={(result.get('target') or {}).get('turnId') or '-'}"
    ))
    if interrupted_exit is not None:
        return interrupted_exit
    return 0 if result.get("status") == "completed" else 1


def user_message_text(item: dict) -> str:
    return "\n".join(
        str(content["text"])
        for content in item.get("content", [])
        if content.get("type") == "text" and content.get("text")
    )


def user_messages(turn: dict) -> list[dict]:
    return [
        item for item in turn.get("items", [])
        if item.get("type") == "userMessage" and user_message_text(item)
    ]


def user_text(turn: dict) -> str:
    return "\n".join(user_message_text(item) for item in user_messages(turn))


def turn_message_time(turn_id: str, ordinal: int) -> str | None:
    compact = str(turn_id).replace("-", "")
    if len(compact) != 32 or compact[12] != "7":
        return None
    try:
        milliseconds = int(compact[:12], 16)
    except ValueError:
        return None
    timestamp = datetime.fromtimestamp(milliseconds / 1000, timezone.utc)
    timestamp += timedelta(microseconds=ordinal)
    return timestamp.isoformat(timespec="microseconds").replace("+00:00", "Z")


def harness_prompt_mode(prompt: str) -> str | None:
    lowered = prompt.lower()
    if prompt == READ_ONLY_HARNESS_PROMPT or "harness proof only" in lowered:
        return "read-only"
    if prompt == standard_harness_prompt() or ("harness pass" in lowered and "harness-ops" in lowered):
        return "standard"
    return None


def agent_text(turn: dict) -> str:
    chunks = [
        str(item["text"])
        for item in turn.get("items", [])
        if item.get("type") == "agentMessage" and item.get("text")
    ]
    return "\n".join(chunks)[:12000]


def rollout_activity_kind(payload: dict) -> str:
    """Classify one native tool call without retaining its arguments or command text."""
    outer = str(payload.get("name") or "").lower()
    encoded = str(payload.get("input") or payload.get("arguments") or "")
    lowered = encoded.lower()
    nested = set(re.findall(r"tools\.([a-zA-Z0-9_]+)", encoded))
    if outer == "wait" or nested.intersection({"wait", "write_stdin"}):
        return "wait"
    if nested.intersection({"apply_patch", "image_gen__imagegen"}):
        return "edit"
    if nested.intersection({"update_plan"}):
        return "plan"
    if nested.intersection({"view_image", "playwright"}) or "playwright" in lowered:
        return "browser"
    if any(marker in lowered for marker in (
        "git push", "git commit", "gh pr create", "gh pr merge", "gh api.*merge",
    )):
        return "delivery"
    if any(marker in lowered for marker in (
        "install-host", "release_status", "deploy.py", "systemctl restart",
    )):
        return "deploy"
    if any(marker in lowered for marker in (
        "validate.sh", "unittest", "pytest", "test_cli.py", "npm test", "bash -n",
    )):
        return "validate"
    if any(marker in lowered for marker in (
        "rg ", "sed -n", "git status", "git diff", "git show", "git log",
        "sqlite", "pragma table_info", "find ", "ls-tree", "readlink",
    )):
        return "inspect"
    return "other"


def summarized_rollout_activity(activities: list[dict]) -> dict:
    """Return fixed-label totals and bounded ordered spans; discard private call material."""
    kinds = ("initial", "inspect", "plan", "edit", "validate", "browser", "delivery",
             "deploy", "wait", "other")
    totals = {
        kind: {"kind": kind, "toolCalls": 0, "toolFailures": 0,
               "toolOutputBytes": 0, "modelCallsAfter": 0}
        for kind in kinds
    }
    spans = []
    for activity in activities:
        if not any(int(activity.get(key) or 0) for key in (
            "toolCalls", "toolFailures", "toolOutputBytes", "modelCallsAfter"
        )):
            continue
        kind = activity["kind"]
        target = totals[kind]
        target["toolCalls"] += int(activity.get("toolCalls") or 0)
        target["toolFailures"] += int(activity.get("toolFailures") or 0)
        target["toolOutputBytes"] += int(activity.get("toolOutputBytes") or 0)
        target["modelCallsAfter"] += int(activity.get("modelCallsAfter") or 0)
        if spans and spans[-1]["kind"] == kind:
            span = spans[-1]
            span["toolCalls"] += int(activity.get("toolCalls") or 0)
            span["toolFailures"] += int(activity.get("toolFailures") or 0)
            span["toolOutputBytes"] += int(activity.get("toolOutputBytes") or 0)
            span["modelCallsAfter"] += int(activity.get("modelCallsAfter") or 0)
        else:
            spans.append({
                "kind": kind,
                "toolCalls": int(activity.get("toolCalls") or 0),
                "toolFailures": int(activity.get("toolFailures") or 0),
                "toolOutputBytes": int(activity.get("toolOutputBytes") or 0),
                "modelCallsAfter": int(activity.get("modelCallsAfter") or 0),
            })
    visible_totals = [record for record in totals.values() if any(
        int(record[key] or 0) for key in (
            "toolCalls", "toolFailures", "toolOutputBytes", "modelCallsAfter"
        )
    )]
    return {
        "totals": visible_totals,
        "spans": spans[:CLOSEOUT_ACTIVITY_SPAN_LIMIT],
        "omittedSpans": max(0, len(spans) - CLOSEOUT_ACTIVITY_SPAN_LIMIT),
    }


def rollout_closeout_evidence(
    rollout_path: str | None, source_thread_id: str, turn_ids: list[str]
) -> dict:
    """Extract privacy-safe whole-burst execution telemetry from the native rollout."""
    unavailable = {
        "status": "unavailable", "evidenceComplete": False, "sourceSha256": None,
        "missingTurnIds": turn_ids, "totals": {}, "turns": [],
    }
    if not rollout_path or not Path(rollout_path).is_absolute():
        return {**unavailable, "reason": "persisted rollout path is unavailable"}
    path = Path(rollout_path)
    if path.suffix != ".jsonl" or not path.is_file():
        return {**unavailable, "reason": "persisted rollout is not a readable JSONL file"}

    wanted = set(turn_ids)
    records = {
        turn_id: {
            "turnId": turn_id, "startedAt": None, "completedAt": None, "durationMs": None,
            "modelCalls": 0, "toolCalls": 0, "toolFailures": 0, "toolOutputBytes": 0,
            "compactions": 0, "usage": {key: 0 for key in usage({})},
            "activity": {},
            "_baselineUsage": {key: 0 for key in usage({})},
            "_lastUsageSum": {key: 0 for key in usage({})},
            "_sawTotalUsage": False,
            "_activities": [{"kind": "initial", "toolCalls": 0, "toolFailures": 0,
                              "toolOutputBytes": 0, "modelCallsAfter": 0}],
            "_activityCalls": {},
            "_lastActivity": None,
        }
        for turn_id in turn_ids
    }
    digest = hashlib.sha256()
    active_turn_id = None
    current_total_usage = {key: 0 for key in usage({})}
    observed_thread_id = None
    parse_error = None
    try:
        with path.open("rb") as handle:
            for line_number, raw_line in enumerate(handle, 1):
                digest.update(raw_line)
                try:
                    item = json.loads(raw_line)
                except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                    parse_error = f"invalid rollout JSON at line {line_number}: {exc}"
                    break
                payload = item.get("payload") if isinstance(item.get("payload"), dict) else {}
                item_type = item.get("type")
                if item_type == "session_meta":
                    # A native fork starts with its own identity and then copies the source
                    # rollout, including the source session_meta record. The first identity is
                    # therefore authoritative for the persisted rollout being evaluated.
                    if observed_thread_id is None:
                        observed_thread_id = payload.get("id")
                elif item_type == "event_msg" and payload.get("type") == "task_started":
                    active_turn_id = payload.get("turn_id")
                    if active_turn_id in wanted:
                        records[active_turn_id]["startedAt"] = item.get("timestamp")
                        records[active_turn_id]["_baselineUsage"] = current_total_usage.copy()
                elif item_type == "event_msg" and payload.get("type") == "token_count":
                    info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
                    total_usage = info.get("total_token_usage")
                    if isinstance(total_usage, dict):
                        current_total_usage = usage(total_usage)
                    if active_turn_id in wanted:
                        last = info.get("last_token_usage")
                        if isinstance(last, dict):
                            records[active_turn_id]["_lastUsageSum"] = usage_add(
                                records[active_turn_id]["_lastUsageSum"], usage(last)
                            )
                            records[active_turn_id]["modelCalls"] += 1
                            activity = records[active_turn_id]["_lastActivity"]
                            if activity is None:
                                activity = records[active_turn_id]["_activities"][0]
                            activity["modelCallsAfter"] += 1
                        if isinstance(total_usage, dict):
                            records[active_turn_id]["_sawTotalUsage"] = True
                elif item_type == "response_item" and active_turn_id in wanted:
                    response_type = payload.get("type")
                    if response_type in {"custom_tool_call", "function_call"}:
                        record = records[active_turn_id]
                        record["toolCalls"] += 1
                        activity = {
                            "kind": rollout_activity_kind(payload), "toolCalls": 1,
                            "toolFailures": 0, "toolOutputBytes": 0, "modelCallsAfter": 0,
                        }
                        record["_activities"].append(activity)
                        record["_lastActivity"] = activity
                        call_id = payload.get("call_id")
                        if call_id:
                            record["_activityCalls"][str(call_id)] = activity
                    elif response_type in {"custom_tool_call_output", "function_call_output"}:
                        record = records[active_turn_id]
                        output_bytes = len(raw_line)
                        record["toolOutputBytes"] += output_bytes
                        activity = record["_activityCalls"].get(str(payload.get("call_id") or ""))
                        if activity is None:
                            activity = record["_lastActivity"]
                        if activity is not None:
                            activity["toolOutputBytes"] += output_bytes
                        if payload.get("is_error") is True or payload.get("success") is False:
                            record["toolFailures"] += 1
                            if activity is not None:
                                activity["toolFailures"] += 1
                elif item_type == "compacted" and active_turn_id in wanted:
                    records[active_turn_id]["compactions"] += 1
                elif item_type == "event_msg" and payload.get("type") == "task_complete":
                    completed_turn_id = payload.get("turn_id")
                    if completed_turn_id in wanted:
                        records[completed_turn_id]["completedAt"] = item.get("timestamp")
                        records[completed_turn_id]["durationMs"] = payload.get("duration_ms")
                        record = records[completed_turn_id]
                        record["usage"] = (
                            usage_delta(current_total_usage, record["_baselineUsage"])
                            if record["_sawTotalUsage"] else record["_lastUsageSum"]
                        )
                    if completed_turn_id == active_turn_id:
                        active_turn_id = None
    except OSError as exc:
        return {**unavailable, "reason": f"cannot read persisted rollout: {exc}"}

    missing = [
        turn_id for turn_id in turn_ids
        if not records[turn_id]["startedAt"] or not records[turn_id]["completedAt"]
    ]
    totals = {
        "turns": len(turn_ids), "modelCalls": 0, "toolCalls": 0, "toolFailures": 0,
        "toolOutputBytes": 0, "compactions": 0,
        "usage": {key: 0 for key in usage({})},
    }
    for record in records.values():
        record["activity"] = summarized_rollout_activity(record["_activities"])
        record.pop("_baselineUsage", None)
        record.pop("_lastUsageSum", None)
        record.pop("_sawTotalUsage", None)
        record.pop("_activities", None)
        record.pop("_activityCalls", None)
        record.pop("_lastActivity", None)
    for record in records.values():
        for key in ("modelCalls", "toolCalls", "toolFailures", "toolOutputBytes", "compactions"):
            totals[key] += int(record[key] or 0)
        totals["usage"] = usage_add(totals["usage"], record["usage"])
    complete = not parse_error and observed_thread_id == source_thread_id and not missing
    reason = parse_error
    if observed_thread_id != source_thread_id:
        reason = "persisted rollout identity does not match the source task"
    elif missing:
        reason = "persisted rollout is missing one or more post-harness turns"
    ordered = [records[turn_id] for turn_id in turn_ids]
    aggregate_activities = []
    for record in ordered:
        for activity in record["activity"]["totals"]:
            aggregate_activities.append(activity)
    return {
        "status": "complete" if complete else "incomplete",
        "evidenceComplete": complete,
        "reason": reason,
        "sourceSha256": digest.hexdigest(),
        "missingTurnIds": missing,
        "totals": totals,
        "activityTotals": summarized_rollout_activity(aggregate_activities)["totals"],
        "turns": ordered,
        "hotspots": sorted(
            ordered,
            key=lambda record: int(record["usage"].get("total") or 0),
            reverse=True,
        )[:5],
    }


def stop_timer(unit: str | None) -> None:
    controller = os.environ.get("DARKEXEC_SYSTEMCTL") or shutil.which("systemctl")
    if not unit or not controller:
        return
    subprocess.run(
        [controller, "stop", f"{unit}.timer", f"{unit}.service"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    )


def schedule_timer(state: dict, executable: Path) -> tuple[bool, str]:
    runner = os.environ.get("DARKEXEC_SYSTEMD_RUN") or shutil.which("systemd-run")
    if not runner:
        return False, "systemd-run is unavailable"
    digest = hashlib.sha256(state["threadId"].encode()).hexdigest()[:12]
    state["timerAttempt"] = int(state.get("timerAttempt") or 0) + 1
    unit = f"darkexec-closeout-{digest}-g{state['generation']}-a{state['timerAttempt']}"
    calendar_due = str(state["dueAt"]).replace("T", " ").removesuffix("Z") + " UTC"
    command = [
        runner, f"--unit={unit}", f"--on-calendar={calendar_due}", "--collect", "--quiet",
        f"--setenv=DARKEXEC_SESSION_ROOT={SESSION_ROOT}",
        f"--setenv=DARKEXEC_CONFIG={CONFIG}",
        f"--setenv=DARKEXEC_APP_SERVER_SOCKET={APP_SERVER_SOCKET}",
        f"--setenv=DARKEXEC_WORKSPACE={WORKSPACE}",
        str(executable), "_debounce-fire", "--thread", state["threadId"],
        "--generation", str(state["generation"]),
    ]
    completed = subprocess.run(command, capture_output=True, text=True, check=False)
    if completed.returncode:
        return False, completed.stderr.strip() or completed.stdout.strip() or "systemd-run failed"
    state["timerUnit"] = unit
    return True, ""


def schedule_closeout_now(
    state: dict, executable: Path, request_id: str,
) -> tuple[bool, str, str]:
    runner = os.environ.get("DARKEXEC_SYSTEMD_RUN") or shutil.which("systemd-run")
    if not runner:
        return False, "systemd-run is unavailable", ""
    digest = hashlib.sha256(state["threadId"].encode()).hexdigest()[:12]
    unit = f"darkexec-closeout-{digest}-g{state['generation']}-manual"
    command = [
        runner, f"--unit={unit}", "--collect", "--quiet",
        f"--setenv=DARKEXEC_SESSION_ROOT={SESSION_ROOT}",
        f"--setenv=DARKEXEC_CONFIG={CONFIG}",
        f"--setenv=DARKEXEC_APP_SERVER_SOCKET={APP_SERVER_SOCKET}",
        f"--setenv=DARKEXEC_WORKSPACE={WORKSPACE}",
        str(executable), "_debounce-fire", "--thread", state["threadId"],
        "--generation", str(state["generation"]), "--request-id", request_id,
    ]
    completed = subprocess.run(command, capture_output=True, text=True, check=False)
    if completed.returncode:
        return (
            False,
            completed.stderr.strip() or completed.stdout.strip() or "systemd-run failed",
            unit,
        )
    return True, "", unit


def inspect_closeout(
    thread: dict, product_turn_id: str
) -> tuple[str, str, str | None, str | None]:
    turns = thread.get("turns") if isinstance(thread.get("turns"), list) else []
    index = next((i for i, turn in enumerate(turns) if turn.get("id") == product_turn_id), None)
    if index is None:
        return "failed", f"recorded product turn {product_turn_id} was not found", None, None
    product = turns[index]
    if product.get("status") != "completed":
        return (
            "deferred", f"recorded product turn is {product.get('status') or 'unknown'}",
            None, None,
        )
    for turn in turns[index + 1:]:
        prompt = user_text(turn)
        if harness_prompt_mode(prompt):
            if turn.get("status") not in {"completed", "failed", "interrupted", "cancelled"}:
                return (
                    "deferred",
                    f"manual harness turn {turn.get('id') or '-'} is {turn.get('status') or 'unknown'}",
                    None, None,
                )
            return (
                "manual_harness_seen",
                f"harness turn {turn.get('id') or '-'} is {turn.get('status') or 'unknown'}",
                turn.get("id"),
                agent_text(turn) or None,
            )
        if turn.get("status") not in {"completed", "failed", "interrupted", "cancelled"}:
            return "deferred", f"newer turn {turn.get('id') or '-'} is active", None, None
        if prompt:
            return "superseded", f"newer product turn {turn.get('id') or '-'} exists", None, None
    return "ready", "", None, None


def thread_turn(thread: dict, turn_id: str | None) -> dict:
    return next(
        (turn for turn in (thread.get("turns") or []) if turn.get("id") == turn_id), {}
    )


def emit_closeout_episode(
    state: dict, thread: dict, *, lifecycle: str, status: str,
    harness_status: str, harness_turn_id: str | None, harness_result: str | None,
    harness_usage: dict | None = None, harness_model_calls: int | None = None,
    error: str | None = None,
) -> tuple[str | None, str | None]:
    product = thread_turn(thread, state.get("productTurnId"))
    return emit_harness_episode(
        lifecycle=lifecycle,
        target_path=state["targetPath"],
        harness_mode=state["harnessMode"],
        status=status,
        target={
            "threadId": state["threadId"],
            "turnId": state.get("productTurnId"),
            "usage": state.get("targetUsage"),
            "modelCallCount": state.get("targetModelCallCount"),
            "resultText": agent_text(product) or None,
        },
        harness={
            "status": harness_status,
            "threadId": state.get("harnessThreadId"),
            "turnId": harness_turn_id,
            "usage": harness_usage,
            "modelCallCount": harness_model_calls,
            "resultText": harness_result,
            "error": error,
        },
        generation=state.get("generation"),
        source={
            "kind": "debounce",
            "threadId": state["threadId"],
            "productTurnId": state.get("productTurnId"),
            "generation": state.get("generation"),
            "harnessThreadId": state.get("harnessThreadId"),
        },
        configuration={
            "command": "debounce",
            "harnessMode": state["harnessMode"],
            "debounceSeconds": state.get("debounceSeconds"),
            "closeoutContext": "source-session",
        },
    )


def fire_debounce(
    thread_id: str, generation: int, executable: Path,
    request_id: str | None = None,
) -> dict:
    path = session_path(thread_id)
    if not path.exists():
        return {"status": "stale", "threadId": thread_id, "reason": "session state is absent"}
    lock = path.with_suffix(".lock").open("a+")
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    state = load_receipt(path)
    if request_id and state.get("closeoutRequestId") != request_id:
        return {
            "status": "stale", "threadId": thread_id, "generation": generation,
            "requestId": request_id,
        }
    if int(state.get("generation") or 0) != generation or state.get("status") != "pending":
        return {"status": "stale", "threadId": thread_id, "generation": generation}
    target = Path(state["targetPath"])
    if not target.is_dir() or not saved_project(target):
        state.update({
            "status": "failed", "error": f"target is no longer an exact saved Codex project: {target}",
            "updatedAt": now(), "timerUnit": None,
        })
        episode_path, episode_error = emit_closeout_episode(
            state, {"turns": []}, lifecycle="deferred", status="failed",
            harness_status="not_started", harness_turn_id=None, harness_result=None,
            error=state["error"],
        )
        state["harnessEpisode"] = {"path": episode_path, "error": episode_error}
        atomic_write(path, state)
        return {"status": "failed", "threadId": thread_id, "error": state["error"]}
    thread: dict = {"turns": []}
    try:
        with AppServer() as app:
            thread = app.require_resumed_thread(thread_id, target)
            status, reason, harness_turn_id, harness_result = inspect_closeout(
                thread, state["productTurnId"]
            )
            if status == "deferred":
                state["updatedAt"] = now()
                state["dueAt"] = (
                    datetime.now(timezone.utc) + timedelta(seconds=int(state["debounceSeconds"]))
                ).replace(microsecond=0).isoformat().replace("+00:00", "Z")
                scheduled, error = schedule_timer(state, executable)
                state["timerUnit"] = state.get("timerUnit") if scheduled else None
                state["error"] = None if scheduled else error
                state["status"] = "pending" if scheduled else "failed"
                if not scheduled:
                    episode_path, episode_error = emit_closeout_episode(
                        state, thread, lifecycle="deferred", status="failed",
                        harness_status="not_started", harness_turn_id=None,
                        harness_result=None, error=error,
                    )
                    state["harnessEpisode"] = {"path": episode_path, "error": episode_error}
                atomic_write(path, state)
                return {"status": state["status"], "threadId": thread_id, "reason": reason, "error": error or None}
            if status != "ready":
                if status == "manual_harness_seen":
                    observed = thread_turn(thread, harness_turn_id)
                    observed_status = observed.get("status") or "completed"
                    terminal_status = "interrupted" if observed_status == "cancelled" else observed_status
                    episode_path, episode_error = emit_closeout_episode(
                        state, thread, lifecycle="manual", status=terminal_status,
                        harness_status=terminal_status, harness_turn_id=harness_turn_id,
                        harness_result=harness_result,
                    )
                else:
                    episode_path, episode_error = emit_closeout_episode(
                        state, thread, lifecycle="deferred", status="abandoned",
                        harness_status="not_started", harness_turn_id=None,
                        harness_result=None, error=reason,
                    )
                state.update({
                    "status": status, "reason": reason, "updatedAt": now(), "timerUnit": None,
                    "harnessTurnId": harness_turn_id, "harnessResult": harness_result,
                    "harnessEpisode": {"path": episode_path, "error": episode_error},
                })
                atomic_write(path, state)
                return {
                    "status": status, "threadId": thread_id, "reason": reason,
                    "harnessTurnId": harness_turn_id, "harnessResult": harness_result,
                }
            state["harnessStatus"] = "starting"
            state["harnessThreadId"] = thread_id
            atomic_write(path, state)
            turns = thread.get("turns") if isinstance(thread.get("turns"), list) else []
            product_index = next(
                index for index, turn in enumerate(turns)
                if turn.get("id") == state["productTurnId"]
            )
            start = 0
            for index, turn in enumerate(turns[:product_index]):
                if harness_prompt_mode(user_text(turn)):
                    start = index + 1
            source_turn_ids = [
                str(turn.get("id")) for turn in turns[start:product_index + 1]
                if turn.get("id")
            ]
            source_evidence = rollout_closeout_evidence(
                thread.get("_rolloutPath"), thread_id, source_turn_ids
            )
            telemetry_totals = source_evidence.get("totals", {})
            state.update({
                "targetUsage": (
                    telemetry_totals.get("usage") if source_evidence["evidenceComplete"] else None
                ),
                "targetModelCallCount": (
                    telemetry_totals.get("modelCalls")
                    if source_evidence["evidenceComplete"] else None
                ),
            })
            atomic_write(path, state)
            def harness_started(_thread_id: str, turn_id: str) -> None:
                state.update({
                    "harnessStatus": "running", "harnessTurnId": turn_id, "updatedAt": now(),
                })
                atomic_write(path, state)
            result = app.run_turn(
                thread_id, state["harnessPrompt"],
                on_started=harness_started,
            )
            app.require_listed_thread(thread_id, target)
            state.update({
                "status": "completed" if result.get("ok") else "failed",
                "harnessStatus": "completed" if result.get("ok") else "failed",
                "harnessTurnId": result.get("turnId"), "harnessResult": result.get("resultText"),
                "harnessUsage": result.get("usage"),
                "harnessModelCallCount": result.get("modelCallCount"),
                "error": result.get("error") or None, "updatedAt": now(), "timerUnit": None,
            })
            episode_path, episode_error = emit_closeout_episode(
                state, thread, lifecycle="deferred", status=state["status"],
                harness_status=state["harnessStatus"], harness_turn_id=state.get("harnessTurnId"),
                harness_result=state.get("harnessResult"), harness_usage=state.get("harnessUsage"),
                harness_model_calls=state.get("harnessModelCallCount"), error=state.get("error"),
            )
            state["harnessEpisode"] = {"path": episode_path, "error": episode_error}
            atomic_write(path, state)
            return {
                "status": state["status"], "threadId": thread_id,
                "harnessThreadId": state.get("harnessThreadId"),
                "harnessTurnId": state.get("harnessTurnId"),
                "harnessResult": state.get("harnessResult"),
                "error": state.get("error"),
            }
    except DispatchInterrupted as exc:
        started = bool(state.get("harnessTurnId"))
        state.update({
            "status": "interrupted", "harnessStatus": "interrupted" if started else "not_started",
            "error": str(exc), "updatedAt": now(), "timerUnit": None,
        })
        episode_path, episode_error = emit_closeout_episode(
            state, thread, lifecycle="deferred", status="interrupted",
            harness_status=state["harnessStatus"], harness_turn_id=state.get("harnessTurnId"),
            harness_result=state.get("harnessResult"), error=state["error"],
        )
        state["harnessEpisode"] = {"path": episode_path, "error": episode_error}
        atomic_write(path, state)
        return {"status": "interrupted", "threadId": thread_id, "error": state["error"]}
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        state.update({"status": "failed", "error": f"debounced closeout failed: {exc}", "updatedAt": now()})
        started = bool(state.get("harnessTurnId"))
        state["harnessStatus"] = "failed" if started else "not_started"
        episode_path, episode_error = emit_closeout_episode(
            state, thread, lifecycle="deferred", status="failed",
            harness_status=state["harnessStatus"], harness_turn_id=state.get("harnessTurnId"),
            harness_result=state.get("harnessResult"), error=state["error"],
        )
        state["harnessEpisode"] = {"path": episode_path, "error": episode_error}
        atomic_write(path, state)
        return {"status": "failed", "threadId": thread_id, "error": state["error"]}


def arm_debounce(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir() or not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    path = session_path(args.thread)
    prior = load_receipt(path) if path.exists() else {}
    if os.environ.get("DARKEXEC_DEBOUNCE_SKIP_PREFLIGHT") != "1":
        try:
            with AppServer() as app:
                thread = app.require_resumed_thread(args.thread, target)
                preflight_status, reason, harness_turn_id, harness_result = inspect_closeout(
                    thread, args.turn
                )
        except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
            raise SystemExit(f"cannot preflight debounced closeout: {exc}") from exc
        if preflight_status != "ready":
            if preflight_status in {"manual_harness_seen", "superseded"}:
                stop_timer(prior.get("timerUnit"))
            if path.exists() and preflight_status == "manual_harness_seen":
                observed = thread_turn(thread, harness_turn_id)
                observed_status = observed.get("status") or "completed"
                terminal_status = "interrupted" if observed_status == "cancelled" else observed_status
                episode_path, episode_error = emit_closeout_episode(
                    prior, thread, lifecycle="manual", status=terminal_status,
                    harness_status=terminal_status, harness_turn_id=harness_turn_id,
                    harness_result=harness_result,
                )
                prior.update({
                    "status": preflight_status, "reason": reason, "updatedAt": now(),
                    "timerUnit": None, "harnessTurnId": harness_turn_id,
                    "harnessResult": harness_result,
                    "harnessEpisode": {"path": episode_path, "error": episode_error},
                })
                atomic_write(path, prior)
            result = {
                "status": preflight_status, "threadId": args.thread, "reason": reason,
                "harnessTurnId": harness_turn_id, "harnessResult": harness_result,
            }
            print(json.dumps(result) if args.json else f"{args.thread}: {preflight_status} ({reason})")
            return 0 if preflight_status in {"manual_harness_seen", "superseded"} else 1
    if (
        prior.get("status") in {"pending", "paused"}
        and prior.get("productTurnId")
        and prior.get("productTurnId") != args.turn
    ):
        episode_path, episode_error = emit_closeout_episode(
            prior, thread if 'thread' in locals() else {"turns": []},
            lifecycle="deferred", status="abandoned", harness_status="not_started",
            harness_turn_id=None, harness_result=None, error="superseded by newer generation",
        )
        prior["harnessEpisode"] = {"path": episode_path, "error": episode_error}
    stop_timer(prior.get("timerUnit"))
    generation = int(prior.get("generation") or 0) + 1
    paused = prior.get("status") == "paused"
    state = {
        "schemaVersion": 1, "threadId": args.thread, "targetPath": str(target),
        "productTurnId": args.turn, "generation": generation,
        "debounceSeconds": args.seconds, "harnessMode": args.harness_mode,
        "harnessPrompt": (
            READ_ONLY_HARNESS_PROMPT
            if args.harness_mode == "read-only"
            else standard_harness_prompt(target)
        ),
        "status": "paused" if paused else "pending", "createdAt": prior.get("createdAt") or now(),
        "updatedAt": now(),
        "dueAt": None if paused else (
            datetime.now(timezone.utc) + timedelta(seconds=args.seconds)
        ).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
        "remainingSeconds": args.seconds if paused else None,
    }
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    atomic_write(path, state)
    if paused:
        result = {
            "status": "paused", "threadId": args.thread, "productTurnId": args.turn,
            "generation": generation, "remainingSeconds": args.seconds,
        }
        print(json.dumps(result) if args.json else f"{args.thread}: harness paused")
        return 0
    scheduled, error = schedule_timer(state, Path(sys.argv[0]).resolve())
    if scheduled:
        atomic_write(path, state)
        result = {
            "status": "pending", "threadId": args.thread, "productTurnId": args.turn,
            "generation": generation, "dueAt": state["dueAt"], "timerUnit": state["timerUnit"],
        }
        print(json.dumps(result) if args.json else f"{args.thread}: harness pending until {state['dueAt']}")
        return 0
    state["scheduleError"] = error
    atomic_write(path, state)
    result = fire_debounce(args.thread, generation, Path(sys.argv[0]).resolve())
    result["scheduleError"] = error
    print(json.dumps(result) if args.json else f"{args.thread}: harness {result['status']} ({error})")
    return 0 if result.get("status") in {"completed", "manual_harness_seen", "superseded"} else 1


def cancel_debounce_thread(thread_id: str) -> dict:
    path = session_path(thread_id)
    if not path.exists():
        return {"status": "absent", "threadId": thread_id}
    lock = path.with_suffix(".lock").open("a+")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        state = load_receipt(path)
        stop_timer(state.get("timerUnit"))
        if (
            state.get("status") in {"pending", "paused"}
            and state.get("targetPath") and state.get("productTurnId")
            and state.get("harnessMode")
        ):
            episode_path, episode_error = emit_closeout_episode(
                state, {"turns": []}, lifecycle="deferred", status="abandoned",
                harness_status="not_started", harness_turn_id=None, harness_result=None,
                error="debounced closeout cancelled",
            )
            state["harnessEpisode"] = {"path": episode_path, "error": episode_error}
        state.update({
            "status": "cancelled", "timerUnit": None, "dueAt": None,
            "remainingSeconds": None, "updatedAt": now(),
        })
        atomic_write(path, state)
        return {"status": "cancelled", "threadId": thread_id, "generation": state.get("generation")}
    finally:
        lock.close()

def cancel_debounce(args) -> int:
    result = cancel_debounce_thread(args.thread)
    print(json.dumps(result) if args.json else f"{args.thread}: {result['status']}")
    return 0


def pending_seconds(state: dict) -> int | None:
    if state.get("status") == "paused":
        return max(0, int(state.get("remainingSeconds") or 0))
    if state.get("status") != "pending" or not state.get("dueAt"):
        return None
    try:
        due = datetime.fromisoformat(str(state["dueAt"]).replace("Z", "+00:00"))
    except ValueError:
        return None
    return max(0, int((due - datetime.now(timezone.utc)).total_seconds()))


def pause_debounce(args) -> int:
    path = session_path(args.thread)
    if not path.exists():
        result = {"status": "absent", "threadId": args.thread}
    else:
        lock = path.with_suffix(".lock").open("a+")
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            state = load_receipt(path)
            if state.get("status") == "pending":
                remaining = pending_seconds(state)
                stop_timer(state.get("timerUnit"))
                state.update({
                    "status": "paused", "timerUnit": None, "dueAt": None,
                    "remainingSeconds": max(1, remaining or 1), "updatedAt": now(),
                })
                atomic_write(path, state)
            result = {
                "status": state.get("status"), "threadId": args.thread,
                "generation": state.get("generation"),
                "remainingSeconds": pending_seconds(state),
            }
        finally:
            lock.close()
    print(json.dumps(result) if args.json else f"{args.thread}: {result['status']}")
    return 0 if result.get("status") == "paused" else 1


def resume_debounce(args) -> int:
    path = session_path(args.thread)
    if not path.exists():
        result = {"status": "absent", "threadId": args.thread}
        print(json.dumps(result) if args.json else f"{args.thread}: absent")
        return 1
    lock = path.with_suffix(".lock").open("a+")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        state = load_receipt(path)
        if state.get("status") != "paused":
            result = {"status": state.get("status"), "threadId": args.thread}
            print(json.dumps(result) if args.json else f"{args.thread}: {result['status']}")
            return 1
        remaining = max(1, int(state.get("remainingSeconds") or state.get("debounceSeconds") or 1))
        state.update({
            "status": "pending", "remainingSeconds": None,
            "dueAt": (datetime.now(timezone.utc) + timedelta(seconds=remaining))
            .replace(microsecond=0).isoformat().replace("+00:00", "Z"),
            "updatedAt": now(),
        })
        scheduled, error = schedule_timer(state, Path(sys.argv[0]).resolve())
        state["timerUnit"] = state.get("timerUnit") if scheduled else None
        if not scheduled:
            state["scheduleError"] = error
        atomic_write(path, state)
        generation = int(state.get("generation") or 0)
    finally:
        lock.close()
    if scheduled:
        result = {
            "status": "pending", "threadId": args.thread, "generation": generation,
            "dueAt": state["dueAt"], "timerUnit": state.get("timerUnit"),
        }
    else:
        result = fire_debounce(args.thread, generation, Path(sys.argv[0]).resolve())
        result["scheduleError"] = error
    print(json.dumps(result) if args.json else f"{args.thread}: {result['status']}")
    return 0 if result.get("status") in {"pending", "completed", "manual_harness_seen", "superseded"} else 1


def closeout_now(args) -> int:
    path = session_path(args.thread)
    if not path.exists():
        result = {"status": "absent", "threadId": args.thread}
        print(json.dumps(result) if args.json else f"{args.thread}: absent")
        return 1
    lock = path.with_suffix(".lock").open("a+")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        state = load_receipt(path)
        if args.detach and state.get("closeoutRequestId"):
            result = {
                "status": state.get("status"), "threadId": args.thread,
                "generation": state.get("generation"),
                "requestId": state["closeoutRequestId"], "accepted": True,
            }
            print(json.dumps(result) if args.json else f"{args.thread}: accepted")
            return 0
        if state.get("status") not in {"pending", "paused"}:
            result = {"status": state.get("status"), "threadId": args.thread}
            print(json.dumps(result) if args.json else f"{args.thread}: {result['status']}")
            return 1
        if args.detach and not re.fullmatch(r"[A-Za-z0-9._:-]{8,128}", args.request_id or ""):
            result = {
                "status": "rejected", "threadId": args.thread,
                "error": "detached closeout requires a valid request id",
            }
            print(json.dumps(result) if args.json else f"{args.thread}: rejected")
            return 1
        if args.note_stdin:
            try:
                state["harnessPrompt"] = prepend_harness_note(
                    state["harnessPrompt"], sys.stdin.read()
                )
            except (KeyError, ValueError) as exc:
                result = {"status": "rejected", "threadId": args.thread, "error": str(exc)}
                print(json.dumps(result) if args.json else f"{args.thread}: rejected ({exc})")
                return 1
        prior_timer = state.get("timerUnit")
        generation = int(state.get("generation") or 0)
        if args.detach:
            scheduled, error, unit = schedule_closeout_now(
                state, Path(sys.argv[0]).resolve(), args.request_id,
            )
            if not scheduled:
                result = {
                    "status": "rejected", "threadId": args.thread,
                    "generation": generation, "error": error,
                }
                print(json.dumps(result) if args.json else f"{args.thread}: rejected ({error})")
                return 1
            state.update({
                "status": "pending", "timerUnit": unit, "remainingSeconds": None,
                "dueAt": now(), "updatedAt": now(),
                "harnessStatus": "queued", "closeoutRequestId": args.request_id,
            })
            atomic_write(path, state)
            stop_timer(prior_timer)
            result = {
                "status": "pending", "threadId": args.thread,
                "generation": generation, "requestId": args.request_id,
                "accepted": True,
            }
            print(json.dumps(result) if args.json else f"{args.thread}: accepted")
            return 0
        stop_timer(prior_timer)
        state.update({
            "status": "pending", "timerUnit": None, "remainingSeconds": None,
            "dueAt": now(), "updatedAt": now(),
        })
        atomic_write(path, state)
    finally:
        lock.close()
    result = fire_debounce(args.thread, generation, Path(sys.argv[0]).resolve())
    print(json.dumps(result) if args.json else f"{args.thread}: {result['status']}")
    return 0 if result.get("status") in {"completed", "manual_harness_seen", "superseded"} else 1


def debounce_status(args) -> int:
    path = session_path(args.thread)
    if not path.exists():
        result = {"status": "absent", "threadId": args.thread}
    else:
        state = load_receipt(path)
        if state.get("status") == "manual_harness_seen" and not state.get("harnessResult"):
            try:
                target = Path(state["targetPath"])
                with AppServer() as app:
                    thread = app.require_resumed_thread(args.thread, target)
                    status, reason, harness_turn_id, harness_result = inspect_closeout(
                        thread, state["productTurnId"]
                    )
                if status == "manual_harness_seen" and harness_result:
                    lock = path.with_suffix(".lock").open("a+")
                    try:
                        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
                        latest = load_receipt(path)
                        if (
                            latest.get("status") == "manual_harness_seen"
                            and not latest.get("harnessResult")
                        ):
                            latest.update({
                                "reason": reason, "harnessTurnId": harness_turn_id,
                                "harnessResult": harness_result, "updatedAt": now(),
                            })
                            atomic_write(path, latest)
                        state = latest
                    finally:
                        lock.close()
            except (KeyError, OSError, RuntimeError, TimeoutError, json.JSONDecodeError):
                pass
        result = {
            key: state.get(key) for key in (
                "schemaVersion", "threadId", "targetPath", "productTurnId", "generation",
                "status", "dueAt", "timerUnit", "harnessTurnId", "harnessResult",
                "error", "updatedAt",
            )
        }
        result["remainingSeconds"] = pending_seconds(state)
    print(json.dumps(result) if args.json else (
        f"{args.thread}: {result['status']} due={result.get('dueAt') or '-'} "
        f"harness={result.get('harnessTurnId') or '-'}"
    ))
    return 0


def runner_matches(state: dict) -> bool:
    runner = state.get("runner") if isinstance(state.get("runner"), dict) else {}
    pid = int(runner.get("pid") or 0)
    start_ticks = runner.get("startTicks")
    return bool(pid and start_ticks is not None and process_start_ticks(pid) == start_ticks)

def signal_runner(state: dict, signum: int) -> bool:
    if not runner_matches(state):
        return False
    pid = int(state["runner"]["pid"])
    descriptor = None
    try:
        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
            descriptor = os.pidfd_open(pid)
            signal.pidfd_send_signal(descriptor, signum)
        else:
            if not runner_matches(state):
                return False
            os.kill(pid, signum)
        return True
    except (OSError, ProcessLookupError):
        return False
    finally:
        if descriptor is not None:
            os.close(descriptor)

def active_turn_id(thread: dict) -> str | None:
    turns = thread.get("turns") if isinstance(thread.get("turns"), list) else []
    for turn in reversed(turns):
        if turn.get("status") not in {"completed", "failed", "interrupted", "cancelled"}:
            return turn.get("id")
    return None

def interrupt_recorded_target(state: dict) -> dict:
    target = state.get("target") if isinstance(state.get("target"), dict) else {}
    thread_id = target.get("threadId")
    turn_id = target.get("turnId")
    if not thread_id:
        return {"attempted": False, "status": "no_target"}
    try:
        with AppServer() as app:
            thread = app.resume_thread(thread_id)
            turn_id = active_turn_id(thread) or turn_id
            if not turn_id or active_turn_id(thread) is None:
                return {
                    "attempted": False, "status": "already_terminal",
                    "threadId": thread_id, "turnId": turn_id,
                }
            app.interrupt_turn(thread_id, turn_id)
            return {
                "attempted": True, "status": "interrupt_sent",
                "threadId": thread_id, "turnId": turn_id,
            }
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        return {
            "attempted": False, "status": "unverified",
            "threadId": thread_id, "turnId": turn_id, "error": str(exc),
        }

def background_stop(executive_thread_id: str, path: Path, args) -> int:
    receipt = load_receipt(path)
    target_thread_id = (receipt.get("target") or {}).get("threadId")
    closeout = cancel_debounce_thread(target_thread_id) if target_thread_id else {
        "status": "absent", "threadId": None,
    }
    live = receipt_runner_active(path)
    if receipt.get("status") in {"completed", "failed", "interrupted"} or not live:
        result = {
            "schemaVersion": 1, "source": "background_job",
            "jobId": receipt.get("jobId"), "executiveThreadId": executive_thread_id,
            "targetThreadId": target_thread_id, "status": "already_stopped",
            "priorStatus": receipt.get("status") if not live else None,
            "mode": "hard" if args.hard else "clean", "closeout": closeout,
        }
        print(json.dumps(result) if args.json else (
            f"{executive_thread_id}: already stopped target={target_thread_id or '-'}"
        ))
        return 0
    interrupt = interrupt_recorded_target(receipt)
    deadline = time.monotonic() + (2 if args.hard else 10)
    while receipt_runner_active(path) and time.monotonic() < deadline:
        time.sleep(0.05)
    latest = load_receipt(path)
    live = receipt_runner_active(path)
    terminal = latest.get("status") in {"completed", "failed", "interrupted"}
    stopped = not live and terminal
    result = {
        "schemaVersion": 1, "source": "background_job",
        "jobId": latest.get("jobId"), "executiveThreadId": executive_thread_id,
        "targetThreadId": (latest.get("target") or {}).get("threadId") or target_thread_id,
        "status": "stopped" if stopped else "partial",
        "receiptStatus": latest.get("status"),
        "mode": "hard" if args.hard else "clean",
        "targetState": interrupt.get("status"),
        "termSent": False, "killSent": False,
        "interrupt": interrupt, "closeout": closeout,
    }
    print(json.dumps(result) if args.json else (
        f"{executive_thread_id}: {result['status']} "
        f"target={result['targetThreadId'] or '-'} target_state={result['targetState']}"
    ))
    return 0 if stopped else 1

def stop_execution(args) -> int:
    executive_thread_id = requested_executive_thread(args)
    if not executive_thread_id:
        raise SystemExit("stop requires --executive-thread or CODEX_THREAD_ID")
    path = execution_path(executive_thread_id)
    if not path.exists():
        try:
            background_path = find_receipt_path(None, executive_thread_id)
        except SystemExit:
            background_path = None
        if background_path:
            return background_stop(executive_thread_id, background_path, args)
        result = {
            "schemaVersion": 1, "executiveThreadId": executive_thread_id,
            "status": "no_active_run", "mode": "hard" if args.hard else "clean",
        }
        print(json.dumps(result) if args.json else f"{executive_thread_id}: no active run")
        return 0
    state = load_receipt(path)
    target_thread_id = (state.get("target") or {}).get("threadId")
    closeout = cancel_debounce_thread(target_thread_id) if target_thread_id else {
        "status": "absent", "threadId": None,
    }
    if state.get("status") not in {"active", "stopping", "stop_partial"}:
        result = {
            "schemaVersion": 1, "executiveThreadId": executive_thread_id,
            "targetThreadId": target_thread_id, "status": "already_stopped",
            "priorStatus": state.get("status"), "mode": "hard" if args.hard else "clean",
            "closeout": closeout,
        }
        print(json.dumps(result) if args.json else (
            f"{executive_thread_id}: already stopped target={target_thread_id or '-'}"
        ))
        return 0
    state = update_execution(executive_thread_id, {
        "status": "stopping", "phase": "stopping",
        "stopRequestedAt": now(), "stopMode": "hard" if args.hard else "clean",
    })
    interrupt = interrupt_recorded_target(state) if args.hard else {
        "attempted": False, "status": "runner_first",
        "threadId": target_thread_id,
    }
    term_sent = signal_runner(state, signal.SIGTERM)
    deadline = time.monotonic() + (2 if args.hard else 10)
    while runner_matches(state) and time.monotonic() < deadline:
        time.sleep(0.05)
    if not args.hard and not runner_matches(state):
        latest = load_receipt(path)
        if not latest.get("targetInterruptAcknowledged"):
            interrupt = interrupt_recorded_target(latest)
    kill_sent = False
    if args.hard and runner_matches(state):
        kill_sent = signal_runner(state, signal.SIGKILL)
        kill_deadline = time.monotonic() + 2
        while runner_matches(state) and time.monotonic() < kill_deadline:
            time.sleep(0.05)
    runner_active = runner_matches(state)
    latest = load_receipt(path)
    target_thread_id = (latest.get("target") or {}).get("threadId") or target_thread_id
    if (
        not runner_active
        and not latest.get("targetInterruptAcknowledged")
        and interrupt.get("status") in {"no_target", "runner_first", "unverified"}
        and target_thread_id
    ):
        interrupt = interrupt_recorded_target(latest)
    if latest.get("targetInterruptAcknowledged") and not runner_active:
        target_state = "interrupt_acknowledged"
    elif interrupt.get("status") == "already_terminal" and not runner_active:
        target_state = "terminal"
    elif interrupt.get("status") == "interrupt_sent" and not runner_active:
        target_state = "interrupt_sent"
    elif not target_thread_id and not runner_active:
        target_state = "not_created"
    else:
        target_state = "unverified"
    stopped = not runner_active and target_state != "unverified"
    final_status = "stopped" if stopped else "partial"
    update_execution(executive_thread_id, {
        "status": "interrupted" if stopped else "stop_partial",
        "phase": "idle" if stopped else "stopping",
        "runner": {"pid": None, "startTicks": None} if stopped else latest.get("runner"),
        "stopResult": {
            "status": final_status, "targetState": target_state,
            "termSent": term_sent, "killSent": kill_sent,
            "interrupt": interrupt, "closeout": closeout,
        },
    })
    result = {
        "schemaVersion": 1, "executiveThreadId": executive_thread_id,
        "targetThreadId": target_thread_id, "status": final_status,
        "mode": "hard" if args.hard else "clean", "targetState": target_state,
        "termSent": term_sent, "killSent": kill_sent,
        "interrupt": interrupt, "closeout": closeout,
    }
    print(json.dumps(result) if args.json else (
        f"{executive_thread_id}: {final_status} target={target_thread_id or '-'} "
        f"target_state={target_state}"
    ))
    return 0 if stopped else 1


def execution_status(args) -> int:
    executive_thread_id = requested_executive_thread(args)
    if not executive_thread_id:
        raise SystemExit("execution-status requires --executive-thread or CODEX_THREAD_ID")
    result = read_execution(executive_thread_id)
    if args.json:
        print(json.dumps(result))
    else:
        print(
            f"{executive_thread_id}: {result['status']} phase={result['phase']} "
            f"target={(result.get('target') or {}).get('threadId') or '-'} "
            f"runner_active={str(result['runnerActive']).lower()}"
        )
    return 1 if result["status"] == "not_found" else 0


def target_status(args) -> int:
    target = Path(args.target).resolve()
    if not target.is_dir() or not saved_project(target):
        raise SystemExit(f"target is not an exact saved Codex project: {target}")
    try:
        with AppServer() as app:
            thread = app.require_resumed_thread(args.thread, target)
    except (OSError, RuntimeError, TimeoutError, json.JSONDecodeError) as exc:
        raise SystemExit(f"cannot inspect target task: {exc}") from exc
    turns = thread.get("turns") if isinstance(thread.get("turns"), list) else []
    baseline = next(
        (index for index, turn in enumerate(turns) if turn.get("id") == args.after_turn),
        None,
    )
    if baseline is None:
        raise SystemExit(f"recorded product turn {args.after_turn} was not found")
    steering_messages = []
    if args.include_input:
        for turn in turns:
            messages = user_messages(turn)
            if not messages or harness_prompt_mode(user_message_text(messages[0])):
                continue
            for ordinal, item in enumerate(messages[1:], start=1):
                message_id = item.get("id")
                turn_id = turn.get("id")
                if not message_id or not turn_id:
                    raise SystemExit("native steering message omitted its identity")
                steering = {
                    "messageId": str(message_id),
                    "turnId": str(turn_id),
                    "inputText": user_message_text(item)[:20000],
                    "ordinal": ordinal,
                }
                created_at = turn_message_time(str(turn_id), ordinal)
                if created_at:
                    steering["createdAt"] = created_at
                steering_messages.append(steering)
                if len(steering_messages) > 100:
                    raise SystemExit("more than 100 native steering messages require reconciliation")
    newer = None
    newer_turns = []
    for turn in turns[baseline + 1:]:
        messages = user_messages(turn)
        if not messages:
            continue
        prompt = user_message_text(messages[0])
        newer = {
            "turnId": turn.get("id"),
            "turnStatus": turn.get("status") or "unknown",
            "turnKind": "harness" if harness_prompt_mode(prompt) else "product",
        }
        if args.include_input:
            newer["inputText"] = prompt[:20000]
        if args.include_result and newer["turnStatus"] in {
            "completed", "failed", "interrupted", "cancelled",
        }:
            newer["resultText"] = agent_text(turn) or None
        if args.include_input or args.include_result:
            newer_turns.append(newer)
            if len(newer_turns) > 100:
                raise SystemExit("more than 100 newer user turns require reconciliation")
    result = {
        "schemaVersion": 1,
        "threadId": args.thread,
        "targetPath": str(target),
        "baselineTurnId": args.after_turn,
        "status": "newer_turn" if newer else "unchanged",
        "newerTurn": newer,
    }
    if args.include_input or args.include_result:
        result["newerTurns"] = newer_turns
    if args.include_input:
        result["steeringMessages"] = steering_messages
    print(json.dumps(result) if args.json else (
        f"{args.thread}: {result['status']} "
        f"turn={(newer or {}).get('turnId') or '-'} "
        f"turn_status={(newer or {}).get('turnStatus') or '-'}"
    ))
    return 0


def steer_target(args) -> int:
    executive_thread_id = requested_executive_thread(args)
    if not executive_thread_id:
        raise SystemExit("steer requires --executive-thread or CODEX_THREAD_ID")
    body = sys.stdin.read()
    if not body.strip():
        raise SystemExit("steer requires a non-empty prompt on stdin")
    if len(body) > 20000:
        raise SystemExit("steer prompt exceeds 20000 characters")
    try:
        input_items = manifest_input(getattr(args, "input_json", None), body)
    except RuntimeError as exc:
        raise SystemExit(str(exc)) from exc
    path = control_path(executive_thread_id)
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.settimeout(20)
    try:
        connection.connect(str(path))
        connection.sendall((json.dumps({
            "threadId": args.thread,
            "expectedTurnId": args.turn,
            "body": body,
            "inputItems": input_items,
            "intentId": args.intent_id,
        }) + "\n").encode())
        connection.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = connection.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
            if sum(map(len, chunks)) > 65536:
                raise RuntimeError("steer acknowledgement is too large")
    except FileNotFoundError:
        raise SystemExit("target is not accepting same-turn steering")
    except (ConnectionRefusedError, socket.timeout, OSError) as exc:
        raise SystemExit(f"cannot deliver same-turn steer: {exc}") from exc
    finally:
        connection.close()
    try:
        result = json.loads(b"".join(chunks))
    except json.JSONDecodeError as exc:
        raise SystemExit("target returned no valid steer acknowledgement") from exc
    print(json.dumps(result) if args.json else (
        f"{result.get('status')} target={result.get('threadId') or args.thread} "
        f"turn={result.get('turnId') or args.turn}"
    ))
    return 0 if result.get("status") == "acknowledged" else 1


def update_install(args) -> int:
    with tempfile.TemporaryDirectory(prefix="darkexec-update-") as temporary:
        checkout = Path(temporary) / "darkexec"
        clone = ["git", "clone", "--quiet", "--depth", "1"]
        if UPDATE_REF:
            clone.extend(["--branch", UPDATE_REF])
        clone.extend([UPDATE_REPOSITORY, str(checkout)])
        fetched = subprocess.run(clone, capture_output=True, text=True, check=False)
        if fetched.returncode:
            raise SystemExit(f"cannot fetch DarkExec update: {fetched.stderr.strip() or fetched.stdout.strip()}")
        fetched_commit = subprocess.run(
            ["git", "-C", str(checkout), "rev-parse", "HEAD"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        if args.expected_commit and fetched_commit != args.expected_commit:
            raise SystemExit(
                f"DarkExec update moved: expected {args.expected_commit}, fetched {fetched_commit}"
            )
        installed = subprocess.run(
            [str(checkout / "scripts/install.sh")],
            capture_output=True, text=True, check=False,
        )
        if installed.returncode:
            raise SystemExit(f"cannot install DarkExec update: {installed.stderr.strip() or installed.stdout.strip()}")
        lines = [line for line in installed.stdout.splitlines() if line.strip()]
        try:
            receipt = json.loads(lines[-1])
        except (IndexError, json.JSONDecodeError) as exc:
            raise SystemExit("DarkExec update installer returned no valid receipt") from exc
    result = {"status": "updated", "repository": UPDATE_REPOSITORY, "ref": UPDATE_REF or None, **receipt}
    print(json.dumps(result) if args.json else (
        f"updated commit={result.get('commit')} workspace={result.get('workspace')} "
        f"next={result.get('nextAction')}"
    ))
    return 0


def identity(args) -> int:
    socket_ready = False
    socket_error = None
    try:
        with AppServer():
            socket_ready = True
    except (OSError, RuntimeError, TimeoutError) as exc:
        socket_error = str(exc)[:500]
    result = {
        "schemaVersion": 1,
        "protocolVersion": REMOTE_PROTOCOL_VERSION,
        "runtimeRevision": runtime_revision(),
        "workspace": str(WORKSPACE),
        "appServerReady": socket_ready,
        "appServerError": socket_error,
        "projects": saved_projects(),
    }
    print(json.dumps(result) if args.json else (
        f"runtime={result['runtimeRevision']} protocol={REMOTE_PROTOCOL_VERSION} "
        f"app_server={'ready' if socket_ready else 'unavailable'}"
    ))
    return 0 if socket_ready and result["projects"] else 1


def find_receipt_path(job_id: str | None, thread_id: str | None) -> Path:
    if job_id:
        path = receipt_path(job_id)
        if not path.exists():
            raise SystemExit(f"unknown DarkExec job: {job_id}")
        return path
    for path in sorted(STATE_ROOT.glob("*.json"), key=lambda item: item.stat().st_mtime, reverse=True):
        receipt = load_receipt(path)
        ids = {
            (receipt.get("executive") or {}).get("threadId"),
            (receipt.get("target") or {}).get("threadId"),
        }
        if thread_id in ids:
            return path
    raise SystemExit(f"unknown DarkExec thread: {thread_id}")

def render_status(receipt: dict) -> str:
    return (
        f"{receipt.get('jobId')}: {receipt.get('status')} "
        f"executive={(receipt.get('executive') or {}).get('threadId') or '-'} "
        f"target={(receipt.get('target') or {}).get('threadId') or '-'} "
        f"harness={((receipt.get('target') or {}).get('harness') or {}).get('status', 'not_started')}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(prog="darkexec")
    sub = parser.add_subparsers(dest="command", required=True)
    launch = sub.add_parser("dispatch")
    launch.add_argument("--target", required=True)
    launch.add_argument("--job-id", required=True)
    launch.add_argument("--prompt-stdin", action="store_true", required=True)
    launch.add_argument("--input-json")
    launch.add_argument("--read-only-harness", action="store_true")
    launch.add_argument("--defer-initial-harness", action="store_true")
    launch.add_argument("--resolve-target", action="store_true")
    launch.add_argument("--json", action="store_true")
    run = sub.add_parser("run")
    run.add_argument("--target", required=True)
    run.add_argument("--executive-thread")
    run_input = run.add_mutually_exclusive_group()
    run_input.add_argument("--source-executive-turn", action="store_true")
    run_input.add_argument("--input-json")
    run.add_argument("--prompt-stdin", action="store_true", required=True)
    harness = run.add_mutually_exclusive_group(required=True)
    harness.add_argument("--read-only-harness", action="store_true")
    harness.add_argument("--standard-harness", action="store_true")
    run.add_argument("--json", action="store_true")
    continuation = sub.add_parser("continue")
    continuation.add_argument("--target", required=True)
    continuation.add_argument("--thread", required=True)
    continuation.add_argument("--executive-thread")
    continuation_input = continuation.add_mutually_exclusive_group()
    continuation_input.add_argument("--source-executive-turn", action="store_true")
    continuation_input.add_argument("--input-json")
    continuation_harness = continuation.add_mutually_exclusive_group()
    continuation_harness.add_argument("--harness-efficiency", action="store_true")
    continuation_harness.add_argument("--harness-standard", action="store_true")
    continuation.add_argument("--prompt-stdin", action="store_true", required=True)
    continuation.add_argument("--json", action="store_true")
    stop = sub.add_parser("stop")
    stop.add_argument("--executive-thread")
    stop.add_argument("--hard", action="store_true")
    stop.add_argument("--json", action="store_true")
    execution_read = sub.add_parser("execution-status")
    execution_read.add_argument("--executive-thread")
    execution_read.add_argument("--json", action="store_true")
    target_read = sub.add_parser("target-status")
    target_read.add_argument("--target", required=True)
    target_read.add_argument("--thread", required=True)
    target_read.add_argument("--after-turn", required=True)
    target_read.add_argument("--include-input", action="store_true")
    target_read.add_argument("--include-result", action="store_true")
    target_read.add_argument("--json", action="store_true")
    steer = sub.add_parser("steer")
    steer.add_argument("--executive-thread")
    steer.add_argument("--thread", required=True)
    steer.add_argument("--turn", required=True)
    steer.add_argument("--intent-id", required=True)
    steer.add_argument("--prompt-stdin", action="store_true", required=True)
    steer.add_argument("--input-json")
    steer.add_argument("--json", action="store_true")
    debounce = sub.add_parser("debounce")
    debounce.add_argument("--target", required=True)
    debounce.add_argument("--thread", required=True)
    debounce.add_argument("--turn", required=True)
    debounce.add_argument("--seconds", type=int, default=1800)
    debounce.add_argument("--harness-mode", choices=("read-only", "standard"), required=True)
    debounce.add_argument("--json", action="store_true")
    pause = sub.add_parser("debounce-pause")
    pause.add_argument("--thread", required=True)
    pause.add_argument("--json", action="store_true")
    resume = sub.add_parser("debounce-resume")
    resume.add_argument("--thread", required=True)
    resume.add_argument("--json", action="store_true")
    cancel = sub.add_parser("debounce-cancel")
    cancel.add_argument("--thread", required=True)
    cancel.add_argument("--json", action="store_true")
    close_now = sub.add_parser("debounce-now")
    close_now.add_argument("--thread", required=True)
    close_now.add_argument("--note-stdin", action="store_true")
    close_now.add_argument("--detach", action="store_true")
    close_now.add_argument("--request-id")
    close_now.add_argument("--json", action="store_true")
    debounce_read = sub.add_parser("debounce-status")
    debounce_read.add_argument("--thread", required=True)
    debounce_read.add_argument("--json", action="store_true")
    fire = sub.add_parser("_debounce-fire")
    fire.add_argument("--thread", required=True)
    fire.add_argument("--generation", type=int, required=True)
    fire.add_argument("--request-id")
    projects = sub.add_parser("projects")
    projects.add_argument("--json", action="store_true")
    harness_prompt_parser = sub.add_parser("harness-prompt")
    prompt_action = harness_prompt_parser.add_mutually_exclusive_group()
    prompt_action.add_argument("--set-stdin", action="store_true")
    prompt_action.add_argument("--reset", action="store_true")
    harness_prompt_parser.add_argument("--target")
    harness_prompt_parser.add_argument("--json", action="store_true")
    efficiency_prompt_setting = sub.add_parser("efficiency-prompt")
    efficiency_prompt_action = efficiency_prompt_setting.add_mutually_exclusive_group()
    efficiency_prompt_action.add_argument("--set-stdin", action="store_true")
    efficiency_prompt_action.add_argument("--reset", action="store_true")
    efficiency_prompt_setting.add_argument("--target")
    efficiency_prompt_setting.add_argument("--json", action="store_true")
    global_resolve = sub.add_parser("resolve-global")
    global_resolve.add_argument("--job-id", required=True)
    global_resolve.add_argument("--candidates-json", required=True)
    global_resolve.add_argument("--prompt-stdin", action="store_true", required=True)
    global_resolve.add_argument("--json", action="store_true")
    update = sub.add_parser("update")
    update.add_argument("--expected-commit")
    update.add_argument("--json", action="store_true")
    identity_read = sub.add_parser("identity")
    identity_read.add_argument("--json", action="store_true")
    status = sub.add_parser("status")
    status_identity = status.add_mutually_exclusive_group(required=True)
    status_identity.add_argument("--job-id")
    status_identity.add_argument("--thread")
    status.add_argument("--wait", action="store_true")
    status.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.command == "dispatch":
        return dispatch(args)
    if args.command == "resolve-global":
        return resolve_global(args)
    if args.command == "identity":
        return identity(args)
    if args.command == "run":
        return run_target(args)
    if args.command == "continue":
        return continue_target(args)
    if args.command == "stop":
        return stop_execution(args)
    if args.command == "execution-status":
        return execution_status(args)
    if args.command == "target-status":
        return target_status(args)
    if args.command == "steer":
        return steer_target(args)
    if args.command == "debounce":
        if args.seconds < 1:
            raise SystemExit("debounce seconds must be positive")
        return arm_debounce(args)
    if args.command == "debounce-pause":
        return pause_debounce(args)
    if args.command == "debounce-resume":
        return resume_debounce(args)
    if args.command == "debounce-cancel":
        return cancel_debounce(args)
    if args.command == "debounce-now":
        return closeout_now(args)
    if args.command == "debounce-status":
        return debounce_status(args)
    if args.command == "_debounce-fire":
        result = fire_debounce(
            args.thread, args.generation, Path(sys.argv[0]).resolve(), args.request_id,
        )
        print(json.dumps(result))
        return 0 if result.get("status") in {"completed", "manual_harness_seen", "superseded", "stale", "pending"} else 1
    if args.command == "projects":
        paths = saved_projects()
        print(json.dumps({"schemaVersion": 1, "projects": paths}) if args.json else "\n".join(paths))
        return 0
    if args.command == "harness-prompt":
        return prompt_setting(
            args, HARNESS_PROMPT_PATH, HARNESS_PROJECT_PROMPT_ROOT,
            DEFAULT_HARNESS_PROMPT, "harness",
        )
    if args.command == "efficiency-prompt":
        return prompt_setting(
            args, EFFICIENCY_PROMPT_PATH, EFFICIENCY_PROJECT_PROMPT_ROOT,
            DEFAULT_EFFICIENCY_PROMPT, "efficiency",
        )
    if args.command == "update":
        return update_install(args)
    path = find_receipt_path(args.job_id, args.thread)
    receipt = wait_for_receipt(path) if args.wait else load_receipt(path)
    print(json.dumps(receipt) if args.json else render_status(receipt))
    return 0 if not args.wait or receipt.get("status") == "completed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
